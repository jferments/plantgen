  "evidence": {
    "generator.params": {
      "evidence": "Authored",
      "source": "plantgen-authors",
      "note": "Hand-set from general knowledge of the species: a single ribbed column that grows a few centimetres in its first decade and fastest in middle age, to 12 to 15 m in about two centuries; its tip widens to an adult diameter near 50 cm, so juveniles are club-shaped. Arms come late (after about 65 years and 3 m), from the middle of the trunk, nearly level, turning up at a constricted elbow; a few droop after freezes. White flowers ring the tips of trunk and arms in late spring with buds and red fruit. Not fitted to measurements."
    },
    "allometry": {
      "evidence": "Authored",
      "source": "plantgen-authors",
      "note": "Rough heights from general knowledge of saguaro growth at sites like Saguaro National Park: about a metre by 40 years, a few metres by 80, about seven by 125. Wide tolerances; replace with measured growth curves before calling this species calibrated."
    },
    "appearance": {
      "evidence": "Authored",
      "source": "plantgen-authors",
      "note": "Colours chosen by eye from photographs: a dull grey-green skin with darker pleats, 12 to 24 ribs by girth, areoles about 2.5 cm apart with brown felt, a dozen or more short radial spines and a few longer, darker centrals, the lowest pointing down, greying with age; old plants corky at the base. Waxy white flowers with yellow centres."
    },
