# The joint-firs (Ephedraceae), on the herb base (growth plan G2.3a):
# switch plants that photosynthesise with green, grooved, jointed stems,
# the leaves reduced to small scales soon shed, the branches in pairs or
# whorls at the joints (Watson and Dallwitz, Families of Gymnosperms;
# Mabberley 2017, "xeromorphic equisetoid shrubs"). Drawn as the
# horsetails are: a clump of upright jointed stems with whorls of three
# green branchlets at each joint, the branchlets on leaf cards. The
# stems are woody and live for years, which the herb base does not draw:
# each year's stems stand in for the standing ones.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem ephedraceae 1 extends herb;

param stems = 24;
param stem_rate = 0.35;
param clump_radius = 0.3;
param stem_lean = 22;
param maturity = 4;
param adult_age = 1000;        # the small cones are not drawn
param stem_height = 1;
param height_spread = 0.2;
param young_height = 1;
param stem_radius = 0.003;
param wiggle = 3;
param arch = 0;
param nodes = 14;              # joints
param leaves_per_node = 3;     # a whorl of green branchlets
param bare = 0.15;
param leaf_length = 0.15;
param leaf_peak = 0.3;
param leaf_top = 0.35;
param leaf_base = 0.8;
param leaf_angle = 35;
param leaf_area = 0.02;        # a green branchlet 1 m long, about 2 mm thick
param basal_leaves = 0;
param basal_length = 0.05;
param basal_angle = 30;
param basal_pieces = 1;
param basal_arch = 0;
param basal_area = 0.02;
param basal_piece_area = 0.02;
param raceme = 0;
param flowering_share = 0;
param scape = 0;
param flowers = 0;
param flower_size = 0.004;
param pedicel = 0;
param flower_divergence = 137.5;
param flower_angle = 30;
param fruit_below = 0;
param buds_above = 1;
param fruit_length = 0.006;
param fruit_angle = 20;
param bud_size = 0.004;
param nod = 0;
param flower_area = 0.6;
param bud_area = 0.6;
param fruit_area = 0.6;
param light_cell = 0.05;
