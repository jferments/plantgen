# Sedge: a clonal stand of shoots on a spreading rhizome, after cattail,
# papyrus, sawgrass and the bulrushes of marshes and lake shores. Each year
# the stand sends up shoots_per_year shoots, scattered over a disc that
# widens as the rhizome runs out,
#
#   R(a) = stand_radius (1 - exp(-a / spread_years))
#
# each at a distance sqrt(u) R(a) from the first for u uniform, so the
# stand stays evenly dense. A shoot lives shoot_life years. It carries
# `leaves` long, narrow leaves from its foot, leaning out by up to
# leaf_angle and arching, and, with the chance flowering, a culm
# culm_height tall (± height_spread) topped by its head:
#
# - head 0, a spike: a cylinder spike_length long at the culm's top (a
#   cattail's brown spike);
# - head 1, an umbel: `rays` thin rays spreading from the top over
#   ray_angle, each ray_length long and ending in a tuft (papyrus);
# - head 2, a panicle: `rays` short branches up the top panicle_length of
#   the culm, each with a cluster of spikelets (sawgrass).
#
# Revision 2 (phyllotaxis P1): a shoot's leaves turn divergence degrees
# from one to the next (120: three ranks, as in sedges; 180: two, as in
# cattails), the name every leaf-bearing program shares, which the rules
# at the vascular plants set from a taxon's phyllotaxis_pattern.
#
# Revision 3 (spec rework M7): a spike and a tuft are inflorescences, not
# a fruit and a leaf.
#
# Revision 4 (growth plan G2.3a): a starting base with no values. Each
# parameter is `param name;`, and the lineage programs that extend it
# (`cyperaceae`, `typha`) give the values, as this program's defaults were
# until then.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem sedge 4;

param vigour_spread;
param shoots_per_year;
param shoot_life;             # years a shoot lives
param stand_radius;           # radius the stand spreads to
param spread_years;           # how fast it spreads
param leaves;                 # leaves a shoot
param leaf_length;
param leaf_spread;            # leaves are leaf_length (1 ± leaf_spread) long
param leaf_angle;             # most a leaf leans out from upright
param divergence;             # roll from one leaf to the next
param flowering;              # chance that a shoot flowers
param flower_age;             # the stand's first year of flowering
param culm_height;
param height_spread;
param culm_radius;
param culm_lean;
param head;                   # 0 spike, 1 umbel, 2 panicle
param spike_length;
param rays;
param ray_angle;              # half the spread of an umbel's rays, or a panicle branch's angle
param ray_length;
param tuft_length;            # an umbel tuft's or a panicle cluster's length
param panicle_length;
param leaf_area;
param spike_area;
param tuft_area;

module Y(v);                  # the stand: vigour
module Sh(k, m, c);           # shoots k to k + m - 1 of this year's cohort, the stand c years old
module Lv(j, m, s);           # leaves j to j + m - 1 of a shoot, s long
module Cu(h);                 # a culm h tall with its head
module Ry(j, m);              # rays or branches j to j + m - 1 of a head
module Sm;                    # a shoot's foot: it dies after shoot_life years

organ leaf leaf area leaf_area;
organ spike fruit as inflorescence area spike_area;
organ tuft leaf as inflorescence area tuft_area;

axiom Y(exp(gauss() * vigour_spread));

rule Y(v) -> Sh(0, max(1, round(shoots_per_year * v)), age) Y(v);

decompose Sh(k, m, c) : m > 1 ->
    Sh(k, floor(m / 2), c) Sh(k + floor(m / 2), m - floor(m / 2), c);
decompose Sh(k, m, c) : m == 1 ->
    [ /(uniform(0, 360)) &(90)
      f(stand_radius * (1 - exp(-c / spread_years)) * sqrt(rand()))
      ^(90) /(uniform(0, 360)) &(uniform(0, culm_lean))
      Sm Lv(0, max(1, round(leaves)), leaf_length * uniform(1 - leaf_spread, 1 + leaf_spread))
      Cu(c >= flower_age && rand() < flowering ? culm_height * uniform(1 - height_spread, 1 + height_spread) : 0) ];
decompose Sh(k, m, c) -> ;

# A shoot dies with everything on it.
rule Sm : age + 1 >= shoot_life -> %;

# Leaves round the shoot's foot, each leaning out a little more.
decompose Lv(j, m, s) : m > 1 ->
    Lv(j, floor(m / 2), s) Lv(j + floor(m / 2), m - floor(m / 2), s);
decompose Lv(j, m, s) : m == 1 ->
    [ /(j * divergence + uniform(-20, 20)) &(leaf_angle * (j + 1) / max(1, leaves))
      leaf(s * (0.7 + 0.3 * (j + 1) / max(1, leaves))) ];
decompose Lv(j, m, s) -> ;

# The culm and its head; no culm on a shoot that does not flower.
decompose Cu(h) : h <= 0 -> ;
decompose Cu(h) : head == 0 ->
    !(culm_radius) F(h - spike_length) spike(spike_length);
decompose Cu(h) : head == 1 ->
    !(culm_radius) F(h) !(culm_radius * 0.25) Ry(0, max(1, round(rays)));
decompose Cu(h) ->
    !(culm_radius) F(h - panicle_length) !(culm_radius * 0.6) Ry(0, max(1, round(rays)));

decompose Ry(j, m) : m > 1 ->
    Ry(j, floor(m / 2)) Ry(j + floor(m / 2), m - floor(m / 2));
# An umbel's ray: out from the top, arching over, with its tuft.
decompose Ry(j, m) : head == 1 ->
    [ /(j * 137.5) &(ray_angle * sqrt((j + 0.5) / max(1, rays))) T(0, -1, 0, 0.3)
      F(ray_length * 0.5) F(ray_length * 0.5) tuft(tuft_length) ];
# A panicle's branch: up the culm's top, a cluster of spikelets on each.
decompose Ry(j, m) ->
    F(panicle_length / max(1, rays)) /(137.5)
    [ &(ray_angle) F(ray_length) tuft(tuft_length) ];
