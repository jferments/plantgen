# Palms (Arecaceae), on the palm base (growth plan G2.3a). It gives the
# values its species leave unset (36 of palm's parameters), as the palm
# program's defaults until then; each species sets the rest.
#
# Revision 2: gives rest_gap, for palm revision 5's fronds that lie on
# the ground.
#
# Revision 3: gives palm revision 7's trunk shape, crownshaft, leaflet
# planes, fan arch and hang, all 0, so a palm draws as before until it
# states them.
#
# Revision 4: gives palm revision 9's new values for a palm: a trunk that
# keeps its girth, fronds one at a time with no scale leaves, and a spear
# whose leaflets come up full length, folded along the rachis, and swing
# out as it opens (Dransfield et al. 2008, p. 7 and 12-16; Kaplan 2022,
# p. 487-496).
#
# Revision 5: gives palm revision 11's crozier values: a palm's spear
# opens without coiling (coil_turns 0); a coiled piece's size,
# tightness, leaflet size and roll as the fern program's
# (`polypodiidae`).
# Revision 6: gives palm revision 12's cones by sex no cones, so
# palms draw as before.
#
# Revision 7: gives palm revision 13's fan palman, threads, petiole
# teeth, twice-pinnate fronds and slowly falling dead fronds none, so
# palms draw as before (Dransfield et al. 2008, p. 16-17).
#
# Revision 8: palm revision 14 stands a year's fronds up the year's
# trunk as they emerge over emerge_spread of the year.
#
# Revision 9: gives palm revision 15's worn boots and root mass none
# (boot_wear, boot_spread, roots 0), so it draws as before.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem arecaceae 9 extends palm;

param vigour_spread = 0.1;   # a palm grows exp(gauss() * vigour_spread) times as fast
param upturn = 0;            # how strongly a leaning trunk turns back up, radians a metre
param frond_seed = 0.15;     # a seedling's fronds, as a share of full size
param frond_spread = 0.08;   # fronds are l (1 ± frond_spread) long
param divergence = 137.5;    # roll from one frond to the next
param angle_spread = 6;
param leaflet_length = 0.25; # the longest leaflet, as a share of the frond's length
param leaflet_peak = 0.35;   # where it sits along the rachis, 0 to 1
param leaflet_base = 0.4;    # the lowest leaflet, as a share of the longest
param leaflet_tip = 0.25;    # the topmost leaflet, as a share of the longest
param leaflet_angle = 60;    # angle of a leaflet to the rachis
param leaflet_lift = 25;     # degrees the leaflets rise into a V
param rays = 40;             # segments of a fan
param fan_spread = 200;      # degrees the segments spread over
param fan_length = 0.5;      # a segment, as a share of the frond's length
param fan_cup = 15;          # degrees the fan's segments rise into a shallow cup
param costa = 0;             # share of the frond's length along which the rays rise from a rib
param season = 0.5;          # share of the year at the keyframe
param emerge_spread = 1;     # fronds emerge over this share of the year
param unroll = 0.2;          # share of a year a frond takes to open
param curl = 0;              # degrees each coiled piece turns back
param skirt = 0;             # 1: dead fronds hang
param dead_angle = 165;      # angle of a hanging dead frond to the vertical
param dead_life = 0;         # years a dead frond hangs
param boots = 0;             # 1: a fallen frond leaves its boot
param boot_life = 10;        # years a boot stays
param boot_length = 0.25;    # a boot, metres
param boot_area = 0.2;
param crown_cone = 0;        # length of a cone at the crown's centre; 0 none
# Palm revision 12's cones by sex: none, as crown_cone, male_cone and
# sporophylls are 0.
param cone_interval = 1;
param cones = 1;
param cone_life = 1;
param cone_width = 0.1;
param peduncle = 0;
param peduncle_radius = 0.01;
param cone_offset = 0;
param cone_lean = 0;
param ripe_lean = 0;
param cone_seeds = 0;
param seed_length = 0.02;
param male_cone = 0;
param male_cones = 1;
param male_cone_life = 1;
param male_peduncle = 0;
param male_lean = 0;
param sporophylls = 0;
param sporophyll_length = 0.2;
param sporophyll_angle = 30;
param sporophyll_ripe = 30;
param ovules = 0;
param adult_age = 10;        # the first year the plant is adult and bears one
param cone_area = 0.6;
param suckers = 0;
param sucker_age = 5;
param sucker_rate = 0.3;
param sucker_distance = 0.4;
param rest_gap = 0.02;       # a frond that reaches the ground lies this far above it
param flare = 0;             # the foot's extra girth, a share of trunk_radius
param flare_years = 1;
param bulge = 0;             # a belly's extra girth, a share of trunk_radius
param bulge_age = 0;
param bulge_years = 1;
param crownshaft = 0;        # a crownshaft's length; 0 none
param shaft_cards = 8; param sheath_area = 0.091;
param sheath_length = 0;     # no sheaths below a frond without a crownshaft
param leaflet_scatter = 0;   # degrees leaflets stand above and below their V
param fan_arch = 0;          # degrees a fan's edge rays droop below its middle
param hang = 0;              # degrees a frond turns down over its life
param thicken = 0;            # a palm's trunk keeps the girth it formed with
param thicken_years = 1;
param flush_interval = 1;     # fronds every year, one at a time
param cataphylls = 0;         # no scale leaves
param cataphyll_length = 0.05;
param cataphyll_angle = 10;
param cataphyll_life = 1;
param cataphyll_area = 0.02;
param leaflet_groups = 2;     # leaflets alternate above and below their V
param coil_short = 0;
param acanthophylls = 0;      # no spines among the leaflets
param spine_length = 0.1;
param spine_area = 0.004;
param boot_angle = 60;
param leaflet_young = 1;      # a spear's leaflets are full length, pleated together
param leaflet_fold = 0.9;     # and lie along the rachis until they open
param coil_turns = 0;         # turns of a circinate frond's rachis in its crozier; 0 coils by curl
param coil_size = 0.22;       # a coiled piece's length at the crozier's outer turn, a share of its open length
param coil_tight = 2;         # how fast the coiled pieces shorten toward the tip
param coil_pinna = 0.12;      # a coiled leaflet at the outer turn, a share of its open size
param coil_roll = 0.08;       # a rolled leaflet's thickness, a share of its rolled length
# Palm revision 13's fan palman, threads, petiole teeth, twice-pinnate
# fronds and slowly falling dead fronds: none, so palms draw as before.
param split_depth = 1;        # fan segments free to the fan's centre
param palman_angle = 12;      # a palman card is a 12-degree wedge, its card 0.24 wide
param palman_area = 0.12;
param tip_droop = 0;
param filaments = 0;          # no threads
param filament_length = 0.5;
param filament_area = 0.01;
param tooth_length = 0;       # no petiole teeth
param tooth_spacing = 0.05;
param tooth_angle = 90;
param tooth_tip = 1;
param tooth_area = 0.25;
param pinna_pairs = 0;        # once pinnate
param pinna_leaflets = 10;
param pinnule_length = 0.2;
param pinnule_angle = 45;
param pinnule_area = 0.3;
param dead_fold_years = 0;    # a dead frond hangs at once
param boot_wear = 0;          # boots keep their length
param boot_wear_years = 1;
param boot_spread = 0;
param roots = 0;              # no roots above the ground
param root_rate = 1;
param root_age = 0;
param root_zone = 0;
param root_zone_years = 1;
param root_angle = 30;
param root_radius = 0.01;
param root_reach = 1;
