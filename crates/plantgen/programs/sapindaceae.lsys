# Maples (Acer, Sapindaceae): the broadleaf tree with what a maple does on
# top of it (growth plan G1).
#
# - Terminal flowering forks the shoots. A maple's flowers come in clusters
#   at the tips of leafy shoots; a shoot that flowers ends there, and the
#   pair of buds below the cluster carry it on as two shoots (a dichasium),
#   so an old maple's limbs fork again and again rather than running on as
#   one axis. Each year a long shoot old enough and in the light flowers
#   with the chance terminal_bloom and forks at twin_angle.
# - The crown is broad and irregular, not an ellipsoid: widest above its
#   middle (crown_widest), fuller than an ellipse (crown_fullness), with
#   crown_lobes bulges round the stem crown_lobe_depth deep (space@2).
# - Space renews: where a limb is shed, its space frees and the crown grows
#   back into the gap (space@2's renew), as old trees rebuild their crowns
#   from sprouts. Without it a crown that has filled its envelope stops
#   making shoots and starves.
# - Short shoots live for decades (spur years) while they have light.
#
# Revision 2 (phyllotaxis P1): its pairs turn by broadleaf's divergence
# and stand for leaves_per_node 2 or more, as broadleaf's do.
#
# Revision 3 (spec rework P6): it reads broadleaf's adult_age, which
# replaces bloom_age.
#
# Revision 4 (crown calibration): its short shoots' leaves with their own
# turn moved to broadleaf (revision 9), which it now inherits; a maple
# grows as before.
#
# Revision 5 (crown form, step A): terminal flowering forks, aborting
# tips, shedding, dormant buds and renewing space moved to broadleaf
# (revision 10), which a maple turns on with its own values here; its
# year's shoot is broadleaf's growth unit. A maple grows as before but
# for the draws those rules take, which now stand at broadleaf's sites.
#
# Revision 6 (crown form, step B): a maple takes broadleaf 11's posture
# and bending, and its stem holds itself upright as broadleaf's does, but
# its lobed envelope still draws its crown (room_width and room_height 1)
# and its tips gather light in proportion (light_half 0, flux 3, as at
# revision 5): a dense maple crown that renews its space outgrows the
# string's module limit in a looser region or with saturating light.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem sapindaceae 6 extends broadleaf;

param bud_years = 30;
param crown_widest = 0.45;      # share of the crown's depth where it is widest
param crown_fullness = 2.2;    # 2: an ellipse in profile; more: fuller
param crown_lobes = 3;         # bulges round the stem
param crown_lobe_depth = 0.18; # how far a bulge reaches, as a share of the radius
param crown_bumps = 0;          # billows: how far smooth noise moves the crown's edge, a share of the radius
param crown_bump_size = 3;      # billows' size, m
param terminal_bloom = 0.35;   # chance a year that a long shoot ends in flowers and forks
param twin_angle = 25;         # angle of each twin shoot from the old axis
param perception = 80;         # half-angle of the cone in which a shoot senses free space
param rise = 0.03;            # upward pull on shoots (negative gravitropism); 0 keeps broadleaf's droop
param steer_weight = 0.1;     # broadleaf's 0.35 sends a renewing crown's shoots looping after free space

param pipe_exponent = 2.3;     # the pipe model's exponent (broadleaf's 2.3); Leonardo's rule is 2
tool pipe@1 { exponent = pipe_exponent };

# The crown's height may approach its envelope at its own rate: a maple
# gains most of its height while young and keeps widening long after
# (open-grown bigleaf maple in the USDA Urban Tree Database reaches 70 % of
# its height by 30 years but only 55 % of its crown width). 0 shares
# crown_rate, as broadleaf does.
param height_rate = 0;
# Each plant draws its own crown once, for its whole life (a draw in a tool
# setting is keyed on the plant's seed alone): its envelope's radius and
# height scaled by up to crown_vary and height_vary either way, and its
# widest point moved by up to widest_vary of the crown's depth. 0 grows
# every plant to the same envelope, as broadleaf does.
param crown_vary = 0;
param height_vary = 0;
param widest_vary = 0;
tool space@2 {
    height = room_height * crown_height * uniform(1 - height_vary, 1 + height_vary)
        * (1 - exp(-(height_rate > 0 ? height_rate : crown_rate) * (t + 3))),
    radius = room_width * crown_radius * uniform(1 - crown_vary, 1 + crown_vary)
        * (1 - exp(-crown_rate * (t + 3))),
    widest = crown_widest + uniform(-widest_vary, widest_vary),
    fullness = crown_fullness,
    lobes = crown_lobes,
    lobe_depth = crown_lobe_depth,
    bumps = crown_bumps,
    bump_size = crown_bump_size,
    angle = perception
};

# Broadleaf's tips abort where they have no free space (apex_death), a
# maple's at a tenth a year; and unless a maple's traits say otherwise
# (the rules at the seed plants), it sheds limbs that no longer pay their
# way, keeps dormant buds that sprout where light comes back, and grows
# back into the space a shed limb frees. Broadleaf says what each does.
param apex_death = 0.1;
param shed_ratio = 0.05;
param shed_age = 8;
param dormant_buds = 1;
param dormant_years = 6;
param sprout_light = 0.25;
param dormant_angle = 60;
param space_renew = 1;

# The lobed envelope draws the crown, and light counts in proportion
# (revision 6; see above).
param room_width = 1;
param room_height = 1;
param light_half = 0;
param flux = 3;

# Shoots rise toward the light against their weight when rise > 0, the
# same pull broadleaf's droop gives downward otherwise, shared by a growth
# unit's nodes.
axiom !(0.004) T(wind, rise > 0 ? 1 : -1, 0, (rise > 0 ? rise : droop + wind_bend * wind) / unit_nodes)
      incline(0, leader_rate) /(uniform(0, 360)) &(uniform(0, lean)) A(fork_height * uniform(0.7, 1.3));

# Blooms spread round a short shoot's tip, as broadleaf's, each carrying
# its own turn.
decompose Bo(n) : n > 0 ->
    bloom(bloom_size * uniform(0.85, 1.15), n * 137.5 + uniform(-20, 20),
          bloom_angle * uniform(0.8, 1.2))
    Bo(n - 1);
