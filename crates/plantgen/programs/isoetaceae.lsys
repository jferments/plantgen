# The quillworts (Isoetaceae), lycophytes, on their class's program
# (growth plan G2.3a): a
# rosette of narrow, tapering leaves from a short, corm-like stem, most of
# them under water, the sporangia sunk in the leaf bases (Mabberley 2017,
# under Isoetaceae and Isoetes). Drawn as the herb's basal leaves round a
# stem kept to a stub: the plant never bears a raceme (adult_age past any
# keyframe), so its one stem stays young_height of its height.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem isoetaceae 1 extends lycopodiopsida;

param stems = 1;
param stem_rate = 1;
param clump_radius = 0.005;
param stem_lean = 0;
param maturity = 2;
param adult_age = 1000;        # no raceme: the sporangia are in the leaf bases
param stem_height = 0.1;
param height_spread = 0.1;
param young_height = 0.05;     # the corm-like stem
param stem_radius = 0.004;
param wiggle = 0;
param arch = 0;
param nodes = 0;
param leaves_per_node = 1;
param bare = 1;
param leaf_length = 0.01;
param leaf_peak = 0.5;
param leaf_top = 1;
param leaf_base = 1;
param leaf_angle = 30;
param leaf_area = 0.02;
param basal_leaves = 24;       # quills round the corm
param basal_length = 0.1;
param basal_angle = 28;
param basal_pieces = 4;
param basal_arch = 6;
param basal_area = 0.02;       # a quill 1 m long is about 2 cm broad at most
param basal_piece_area = 0.02;
param raceme = 0;
param flowering_share = 0;
param scape = 0;
param flowers = 0;
param flower_size = 0.002;
param pedicel = 0;
param flower_divergence = 137.5;
param flower_angle = 20;
param fruit_below = 0;
param buds_above = 1;
param fruit_length = 0.002;
param fruit_angle = 20;
param bud_size = 0.002;
param nod = 0;
param flower_area = 0.6;
param bud_area = 0.6;
param fruit_area = 0.6;
param light_cell = 0.02;
