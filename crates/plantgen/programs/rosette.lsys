# Rosette: thick leaves held in a tight spiral round a short or tall stem,
# after the agaves, aloes, yuccas, sotols and bromeliads of dry country.
# Each year the crown adds leaf_rate leaves on a golden-angle spiral (or
# in two ranks, a fan), each one a little above the last on the stem. A
# leaf stands nearly upright in the central cone as it unfolds and opens
# out as it ages, toward old_angle, then dies after leaf_life years: a
# dead leaf falls (skirt 0) or folds down against the stem and hangs there
# as a skirt (skirt 1), for dead_life years. A leaf's length follows the
# rosette's own age, so the first leaves are small and an old rosette's
# leaves full size:
#
#   l(a) = leaf_length (leaf_seed + (1 - leaf_seed) (1 - exp(-a v / size_years)))
#
# where a is the age of the crown that bears it and v its vigour.
#
# A stem grows trunk_rate metres a year under the crown (0: a stemless
# rosette on the ground). Once flower_age old, a crown flowers: a stalk
# stalk_height tall rises from its centre with stalk_branches side
# branches in its top stalk_head share, each ending in a cluster of
# flowers, or flowers all along a spike (stalk_branches 0). A monocarpic
# rosette (once 1: an agave) flowers once and dies: it grows no more
# leaves, and its leaves die off over the next years. Others flower every
# year with the chance bloom; a forking rosette (fork 1: a Joshua tree)
# stops where it flowered and two or three crowns wake below it, so the
# number of forks is the plant's flowering history. Old stalks stand dry
# for stalk_life years.
#
# A rosette may send out pups: from pup_age, with the chance pup_rate a
# year, a small crown appears pup_distance out on a runner, at most pups
# of them.
#
# Revision 2 (growth plan G2.3a): a starting base with no values. Each
# parameter is `param name;`, and the lineage programs that extend it
# (`asparagaceae`, `aloe`, `hechtia`) give the values, as this program's
# defaults were until then.
#
# Revision 3 (leaf life): leaves, dead leaves and flowering stalks live as
# long as their parameters say, no longer one year more. What a step makes
# is born at the step's end, so a rule that ends a part by its age counts
# the step it is in (`age + dt >=`).
#
# Revision 4 (stemless rosettes): a stemless rosette (stemless 1: a basal
# rosette, an agave's) keeps its crown on the ground. Its stem gains a
# little with every leaf, but the stem below the living leaves is not
# drawn: an internode goes with its leaf, when the leaf falls (or, in a
# skirt, when the dead leaf does), so the stem shown is only the short one
# the living leaves stand on, and a pup's runner drops from the crown to
# the ground as its parent's stem goes. Before, an old agave's crown stood
# on a bare cylinder of every internode it had grown.
#
# Revision 5 (branching rosettes): a forking rosette's branches fork
# again by the length they have grown, not only when they flower. A
# Joshua tree's tip dies when it flowers or when insects kill it, and two
# or three branches grow from below it; its trunk grows 0.9 to 3 m before
# it first forks, and its branches then fork every 0.6 to 0.9 m (USDA
# FEIS, Yucca brevifolia). The first fork stays as it was, by flower_age
# and bloom; a branch (n 1) forks once it has grown fork_length, and on
# average fork_spread / 2 later. A branch's leaves are sized by the
# plant's age, not its own, since a new crown on an old tree bears full
# leaves. Its stem thickens girth_rate metres a year, so an old trunk is
# thicker than the branches it carries. Only forking rosettes (fork 1)
# take the new rules, which come last so that every other rosette keeps
# its random draws.
#
# Revision 6 (leaves on a thick stem): where the stem thickens, a leaf
# grows from its surface, not its axis, so the leaf bases hide the stem
# inside a rosette; a leaf standing up grows nearer the axis, by the sine
# of its angle, so the young leaves close over the bud as a cone. A dead
# leaf hangs from the surface too, so that it folds down along the stem
# (FEIS: "fold down, covering the branches") rather than inside it.
#
# Revision 7 (bare tips): a forking rosette's leaves stand evenly up
# each year's stem, not in a ring at its top with bare stem between, and
# its stem narrows inside its living leaves to its bud, from trunk_radius where its oldest living
# leaves stand to three tenths of it at the tip, so the leaves hide it;
# before, it stood up through the rosette as a flat-topped cylinder at
# full width, the young leaves growing out of its cut end. A flowered or
# killed tip dies back to a blunt knob between the crowns that wake
# below it, its stem closing over a stem's radius; before, its flat cut
# end showed between them as a bare disc. A hanging dead leaf greys
# grey_years after it died (a `dead_grey` organ, drawn as `dead`
# greyed unless the species gives it a look), so a skirt is straw only
# near the leaves.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem rosette 7;

# The plant.
param vigour_spread;          # a rosette grows exp(gauss() * vigour_spread) times as fast
param lean;                   # most degrees the stem leans at its foot
# Leaves.
param leaf_rate;              # leaves a crown adds a year
param leaf_life;              # years a leaf lives
param leaf_length;            # a full-size leaf's length
param leaf_seed;              # a seedling's leaves, as a share of full size
param size_years;             # leaves reach full size over about this many years
param leaf_spread;            # leaves are l (1 ± leaf_spread) long
param divergence;             # roll from one leaf to the next; 180 for two ranks
param young_angle;            # angle of a new leaf to the stem's axis
param old_angle;              # the angle an old leaf opens to
param open_years;             # how fast a leaf opens, years
param angle_spread;           # spread of each leaf's angle
param internode;              # stem between one leaf and the next
param skirt;                  # 1: dead leaves fold down and hang
param dead_angle;             # angle of a hanging dead leaf to the stem's axis
param dead_life;              # years a dead leaf hangs before it falls
param leaf_area;              # leaf area of a leaf 1 m long, m²
param dead_area;              # and of a dead leaf
# The stem.
param trunk_rate;             # metres a year the stem grows under the crown
param trunk_radius;           # the stem's radius under the crown
param fork;                   # 1: flowering ends a crown, which forks below
param forks_low;              # crowns that wake below a flowered tip
param forks_high;
param fork_angle;             # angle a new crown leans out from the old axis
param upturn;                 # how strongly a leaning crown's stem turns back up, radians a metre
param fork_length;            # a branch's growth before it may fork
param fork_spread;            # forks fall over this much more growth
param girth_rate;             # metres a year a forking rosette's stem thickens
param stemless;               # 1: the stem below the living leaves is not drawn
param grey_years;             # a hanging dead leaf greys after about this many years; 0 never
# Flowering.
param flower_age;             # the first year a crown may flower
param once;                   # 1: a crown flowers once and dies
param bloom;                  # chance a year an old enough crown flowers
param stalk_height;           # the stalk's height above the crown
param stalk_radius;           # its radius at the foot, at most trunk_radius
param stalk_head;             # share of the stalk, from the top, that flowers
param stalk_branches;         # side branches of the flowering head; 0 a spike
param branch_length;          # a side branch's length at the foot of the head
param branch_angle;           # angle of a side branch to the stalk
param flowers;                # flowers on a spike, or on each branch
param flower_size;
param flower_angle;           # angle of a flower to its stalk
param stalk_life;             # years a dry stalk stands
param flower_area;
# Pups.
param pups;                   # most pups a rosette sends out
param pup_age;                # the rosette's first year of pups
param pup_rate;               # chance a year of a new pup
param pup_distance;           # how far out a pup appears

module Y(v, n, p);            # a crown: vigour, flowers so far (once: dying), pups so far
module Lc(i, m, c);           # leaves i to i + m - 1 of this year's cohort, on a crown c years old
module Lv(s, a);              # a living leaf s long at a degrees out from the axis
module Dv(s);                 # a dead leaf hanging
module Sm;                    # the foot of a stalk: it falls, and the stalk with it
module Sk;                    # a flowering stalk
module Hd(i, m, h, b);        # flowering nodes i to i + m - 1 of a head h long; b 1 on the main stalk
module Bh(l);                 # a side branch l long with its flowers
module Fk(j);                 # j crowns still to wake below a flowered tip
module Pp;                    # a pup on its runner
module In;                    # a stemless rosette's internode, which goes with its leaf
module Dn(h);                 # a pup's drop to the ground, h at its birth
module Sg(l);                 # a forking rosette's year of stem, l long: its turn up
module Lf(i, m, c, l, k);     # a forking rosette's cohort of leaves, as Lc, k of them on its year's l of stem
module Ls(u, d);              # a piece of its stem d long, u of the way up its year
module Dg(s, g);              # a dead leaf hanging, greyed, g years dead when it greyed
module Rc;                    # a forked tip's dead knob

organ blade leaf area leaf_area;
organ dead leaf area dead_area;
organ dead_grey leaf area dead_area;
organ flower flower area flower_area;

axiom /(uniform(0, 360)) &(uniform(0, lean)) Y(exp(gauss() * vigour_spread), 0, 0);

# The crown. A dying monocarpic crown (n < 0) grows nothing more.
rule Y(v, n, p) : n < 0 -> Y(v, n, p);
# A monocarpic crown in flower: the stalk, then it dies.
rule Y(v, n, p) : once > 0 && age * v >= flower_age && rand() < bloom ->
    [ Sm Sk ] Y(v, -1, p);
# A forking crown in flower: the stalk ends it, and crowns wake below.
rule Y(v, n, p) : fork > 0 && n == 0 && age * v >= flower_age && rand() < bloom ->
    [ Sm Sk ] Rc Fk(round(uniform(forks_low, forks_high + 0.999) - 0.5));
# A crown in flower that goes on.
rule Y(v, n, p) : once == 0 && fork == 0 && age * v >= flower_age && rand() < bloom ->
    [ Sm Sk ] !((stemless > 0 ? max(0.5 * trunk_radius, stalk_radius) : trunk_radius)) T(0, 1, 0, upturn * trunk_rate * v) F(trunk_rate * v) Lc(0, max(1, round(leaf_rate * v)), age * v) Y(v, n + 1, p);
# A pup.
rule Y(v, n, p) : pups > p && age >= pup_age && rand() < pup_rate ->
    [ Pp ] !((stemless > 0 ? max(0.5 * trunk_radius, stalk_radius) : trunk_radius)) T(0, 1, 0, upturn * trunk_rate * v) F(trunk_rate * v) Lc(0, max(1, round(leaf_rate * v)), age * v) Y(v, n, p + 1);
rule Y(v, n, p) : fork == 0 -> !((stemless > 0 ? max(0.5 * trunk_radius, stalk_radius) : trunk_radius)) T(0, 1, 0, upturn * trunk_rate * v) F(trunk_rate * v) Lc(0, max(1, round(leaf_rate * v)), age * v) Y(v, n, p);

# This year's leaves, a little apart up the stem, each turned on round
# the spiral and opening out. Leaves are sized by the crown's age.
decompose Lc(i, m, c) : m > 1 ->
    Lc(i, floor(m / 2), c) Lc(i + floor(m / 2), m - floor(m / 2), c);
decompose Lc(i, m, c) : m == 1 && stemless == 0 ->
    !(trunk_radius) F(internode) /(divergence + gauss() * 3)
    [ Lv(leaf_length * (leaf_seed + (1 - leaf_seed) * (1 - exp(-c / size_years)))
         * uniform(1 - leaf_spread, 1 + leaf_spread),
         gauss() * angle_spread) ];
decompose Lc(i, m, c) : m < 1 -> ;

# A leaf opens with age, then dies: it falls, or folds down and hangs.
rule Lv(s, a) : age + dt >= leaf_life && skirt > 0 -> Dv(s);
rule Lv(s, a) : age + dt >= leaf_life -> ;
rule Dv(s) : age + dt >= dead_life -> ;
# A thickening stem (revision 5) bears its leaves on its surface, so
# their bases hide it in the rosette: a leaf standing up nearer the
# axis, so the young leaves close over the bud as a cone. It carries its
# dead leaves out there, where they hang, as it grows wider under them.
interpret Lv(s, a) : girth_rate > 0 ->
    &(90) f((trunk_radius * (0.3 + 0.7 * min(1, age / leaf_life)) + girth_rate * age)
        * sin(min(lerp(young_angle, old_angle, 1 - exp(-age / open_years)) + a, 90) * 0.0174533))
    ^(90) &(lerp(young_angle, old_angle, 1 - exp(-age / open_years)) + a) blade(s);
interpret Lv(s, a) ->
    &(lerp(young_angle, old_angle, 1 - exp(-age / open_years)) + a) blade(s);
interpret Dv(s) : girth_rate > 0 ->
    &(90) f(trunk_radius + girth_rate * (leaf_life + age)) ^(90) &(dead_angle) dead(s);
interpret Dv(s) -> &(dead_angle) dead(s);

# The stalk: the bare foot, then the flowering head, as a spike or a
# panicle of side branches. It stands dry for stalk_life years.
rule Sm : age + dt >= stalk_life -> %;
decompose Sk ->
    !(stalk_radius) F(stalk_height * (1 - stalk_head))
    Hd(0, stalk_branches > 0 ? stalk_branches : flowers, stalk_height * stalk_head, 1);
decompose Hd(i, m, h, b) : m > 1 ->
    Hd(i, floor(m / 2), h, b) Hd(i + floor(m / 2), m - floor(m / 2), h, b);
decompose Hd(i, m, h, b) : m == 1 && b > 0 && stalk_branches > 0 ->
    !(stalk_radius * 0.6) F(h / stalk_branches) /(137.5)
    [ &(branch_angle) Bh(branch_length * (1 - 0.6 * (i + 0.5) / stalk_branches)) ];
decompose Hd(i, m, h, b) : m == 1 ->
    !(stalk_radius * (b > 0 ? 0.5 : 0.25)) F(h / max(1, b > 0 ? flowers : max(3, round(flowers / 3)))) /(137.5)
    [ &(flower_angle) flower(flower_size * uniform(0.9, 1.1)) ];
decompose Hd(i, m, h, b) -> ;
decompose Bh(l) -> !(stalk_radius * 0.3) F(l * 0.4) Hd(0, max(3, round(flowers / 3)), l * 0.6, 0);

# Crowns that wake below a flowered tip, leaning out round it.
decompose Fk(j) : j > 0 ->
    [ /(360 * j / max(1, forks_high) + uniform(-25, 25)) &(fork_angle * uniform(0.7, 1.3))
      Y(exp(gauss() * vigour_spread), 1, pups) ]
    Fk(j - 1);
decompose Fk(j) -> ;
# A forked tip dies back to a blunt knob (revision 7), closing over a
# stem's radius, as wide as the stem is there.
interpret Rc ->
    [ !(0.9 * (trunk_radius * (0.3 + 0.7 * min(1, age / leaf_life)) + girth_rate * age)) F(0.4 * (trunk_radius * (0.3 + 0.7 * min(1, age / leaf_life)) + girth_rate * age))
      !(0.5 * (trunk_radius * (0.3 + 0.7 * min(1, age / leaf_life)) + girth_rate * age)) F(0.4 * (trunk_radius * (0.3 + 0.7 * min(1, age / leaf_life)) + girth_rate * age)) ];

# A pup: out along a runner at the foot, then up, a small crown of its own.
decompose Pp : stemless == 0 ->
    /(uniform(0, 360)) &(90) f(pup_distance * uniform(0.6, 1.4)) ^(90)
    Y(exp(gauss() * vigour_spread), 0, pups);

# A stemless rosette (revision 4), last in the program so that the random
# draws above keep their places. Its leaves stand on internodes that go
# with them: an internode lasts as long as its leaf, dead or alive. The
# leaves' broad bases wrap the short stem they stand on, so it is drawn
# half as thick, inside them (by eye: at full thickness it showed as a
# tan collar between the lowest leaves), but never thinner than the
# flowering stalk it carries.
decompose Lc(i, m, c) : m == 1 ->
    !(max(0.5 * trunk_radius, stalk_radius)) In /(divergence + gauss() * 3)
    [ Lv(leaf_length * (leaf_seed + (1 - leaf_seed) * (1 - exp(-c / size_years)))
         * uniform(1 - leaf_spread, 1 + leaf_spread),
         gauss() * angle_spread) ];
rule In : age + dt >= leaf_life + (skirt > 0 ? dead_life : 0) -> ;
interpret In -> F(internode);
# Its pup starts at the parent's crown, as high as the parent's living
# leaves stand on the stem, and drops with that stem as those leaves
# fall, so it reaches the ground in leaf_life years.
decompose Pp ->
    Dn(min(leaf_life, pup_age) * max(1, round(leaf_rate)) * internode)
    /(uniform(0, 360)) &(90) f(pup_distance * uniform(0.6, 1.4)) ^(90)
    Y(exp(gauss() * vigour_spread), 0, pups);
interpret Dn(h) -> f(-h * max(0, 1 - age / leaf_life));

# A forking rosette (revision 5), last in the program so that the random
# draws above keep their places. A branch forks once it has grown
# fork_length, with a chance a year that puts the fork on average
# fork_spread / 2 later: its tip dies, flowering or eaten, and crowns
# wake below it.
rule Y(v, n, p) : fork > 0 && n > 0 && age * v * trunk_rate >= fork_length
    && rand() < 2 * trunk_rate * v / max(fork_spread, 0.001) ->
    [ Sm Sk ] Rc Fk(round(uniform(forks_low, forks_high + 0.999) - 0.5));
# Its stem grows under the crown and thickens with age; its leaves are
# sized by the plant's age.
rule Y(v, n, p) : fork > 0 ->
    Sg(trunk_rate * v)
    Lf(0, max(1, round(leaf_rate * v)), t * v,
       trunk_rate * v + internode * max(1, round(leaf_rate * v)), max(1, round(leaf_rate * v)))
    Y(v, n, p);
interpret Sg(l) -> T(0, 1, 0, upturn * l);
# Its leaves stand evenly up the year's stem (revision 7), each on its
# piece of it, so no bare stem shows between one year's leaves and the
# next's; a piece is as thick as the stem is there, which narrows inside
# the living leaves to the bud.
decompose Lf(i, m, c, l, k) : m > 1 ->
    Lf(i, floor(m / 2), c, l, k) Lf(i + floor(m / 2), m - floor(m / 2), c, l, k);
decompose Lf(i, m, c, l, k) : m == 1 ->
    Ls((i + 0.5) / k, l / k) /(divergence + gauss() * 3)
    [ Lv(leaf_length * (leaf_seed + (1 - leaf_seed) * (1 - exp(-c / size_years)))
         * uniform(1 - leaf_spread, 1 + leaf_spread),
         gauss() * angle_spread) ];
decompose Lf(i, m, c, l, k) -> ;
interpret Ls(u, d) -> !(trunk_radius * (0.3 + 0.7 * min(1, (age + 1 - u) / leaf_life)) + girth_rate * (age + 1 - u)) F(d);

# A dead leaf greys as it weathers (revision 7): between half and one and
# a half times grey_years after it died, a share set by the last digits
# of its length (no draw, so the lineage programs' draws keep their
# places), so a skirt shades from straw at the top to grey below. It
# falls when it would have.
rule Dv(s) : grey_years > 0
    && age + dt >= grey_years * (0.5 + s * 10000 - floor(s * 10000)) -> Dg(s, age + dt);
rule Dg(s, g) : g + age + dt >= dead_life -> ;
interpret Dg(s, g) : girth_rate > 0 ->
    &(90) f(trunk_radius + girth_rate * (leaf_life + g + age)) ^(90) &(dead_angle) dead_grey(s);
interpret Dg(s, g) -> &(dead_angle) dead_grey(s);
