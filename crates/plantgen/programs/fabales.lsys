# The woody Fabaceae of the order Fabales, whose family program grows its
# herbs, on the broadleaf base (growth plan G2.3a). It gives the values
# its species leave unset (48 of broadleaf's parameters), as the broadleaf
# program's defaults until then; each species sets the rest.
#
# One step is one year. Angles are degrees; lengths are metres.

# Revision 2: a species that leaves `blooms` unset bears one bloom on
# each short shoot in the light once adult, as on broadleaf's forms;
# until now it bore none, so it never flowered or fruited.

lsystem fabales 2 extends broadleaf;

param bud_break = 1.3;      # vigour a lateral bud needs to grow a long shoot
param flux = 2;             # Borchert-Honda alpha: vigour per unit of light
param light_half = 0.3;     # light at which a tip gathers half of full light's vigour; 0: in proportion
param bud_years = 40;       # years a lateral bud lives as a short shoot while it has light
param spur_light = 0.1;     # light a short shoot needs to leaf out
param shade_death = 0.06;   # light below which a bud dies
param steer_weight = 0.35;  # how far a shoot turns toward free space
param leaf_years = 1;       # years a leaf stays on: more than 1 for evergreens
param blooms = 1;           # blooms at the tip of a short shoot in the light
param adult_age = 4;        # the first year the plant is adult and flowers
param bloom_size = 0.05;    # bloom card length
param bloom_angle = 35;     # angle of a bloom to its shoot; past 90 it hangs
param bloom_area = 0.639;   # leaf area of a bloom card 1 m long, m²
param lean = 0;             # the most the stem leans from upright
param thorns = 0;           # 1: a thorn beside each bud
param thorn_length = 0.02;
param thorn_angle = 60;     # angle of a thorn to its shoot
param thorn_area = 0.235;   # leaf area of a thorn card 1 m long, m² (the default leaf card's)
param wind = 0;             # strength of a steady wind toward +X; 0 none
param wind_bend = 0.05;     # extra downwind bending per unit of wind
param wind_kill = 0.3;      # a tip heading upwind beyond this dies
param life = 0;             # age at which the plant dies; 0 never
param snag_fall = 0.15;     # chance a year that a dead branch falls
param extinction = 0.5;
param light_cell = 0.5;     # light voxel edge; smaller for shrubs
param space_reach = 2.4;    # how far a bud senses free space
param shed_ratio = 0;       # a limb older than shed_age is shed when qsum < shed_ratio * nseg; 0: only bare limbs
param shed_age = 8;
param dormant_buds = 0;     # 1: each node keeps a dormant bud that sprouts where light reaches
param dormant_years = 6;    # years a dormant bud lives
param sprout_light = 0.25;  # light at which a dormant bud sprouts
param dormant_angle = 60;   # a dormant bud's angle from its shoot
param space_renew = 0;      # 1: free space returns where the plant's parts are shed
param terminal_bloom = 0;   # chance a year that a long shoot ends in flowers and forks
param twin_angle = 25;      # angle of each twin shoot from the old axis
param apex_death = 0;       # chance a year that a tip with no free space aborts
param room_width = 1.6;     # free space fills this many times the crown's radius
param room_height = 1.3;    # and this many times its height
param crown_phototropism = 0.3; # the region's front turns this far toward its light
param limb_path = 1;        # how many times a limb's wood counts toward path_half (1: as the stem's)
param leader_rate = 0.3;    # how far each node of the stem turns back toward upright
param set_point = 50;       # a limb's held angle from straight up
param incline_rate = 0.3;   # how far each node of a limb turns toward set_point
param wood_density = 600;   # kg/m³ of green wood
param wood_modulus = 10000; # modulus of elasticity, MPa
param leaf_mass = 0.1;      # kg per m² of leaf
param bend_set = 0.1;       # share of each year's sag the wood keeps
param stem_bend = 0;        # share of its sag the stem and a fork's stems take: reaction wood holds them up
param straighten = 0.3;     # share of its kept bend the wood straightens each year
