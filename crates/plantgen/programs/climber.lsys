# Climber: a vine that climbs its host, after ivy and the wild grapes.
# From its foot `shoots` stems set out toward the host. A shoot's tip reads
# the host (`host@1`): the distance gd to the host's surface and the
# direction (gx, gy, gz) to it. Within `cling` of the host a shoot clings:
# it turns hug of the way toward the host each internode and climbs under
# an upward tropism of elasticity `climb`, so it runs up the trunk and out
# along the limbs. Within the tool's reach but farther than `cling` it
# turns seek of the way toward the host. Out of reach (above the crown,
# or with no host) it hangs: a tropism toward the ground of elasticity
# drape, so a liana spreads over its host's crown and drapes from it, and
# a vine with no host sprawls over the ground.
#
# A shoot grows up to max_shoot internodes a year, fewer in shade, and
# forks at each node with the chance branch_chance into a side shoot of the
# next order, up to max_order; a shoot that has hung free for free_years
# stops. Each node bears a leaf (evergreen for leaf_years, or a year) and
# keeps a bud that leafs again each year with the chance renew, so old
# stems stay clothed as ivy's do; and,
# once the vine is adult_age old, on a free shoot a cluster of fruit with
# the chance fruiting.
#
# Revision 2 (phyllotaxis P1): each node turns divergence degrees from the
# one below, give or take a little (180: two ranks, as in grapes), the
# name every leaf-bearing program shares, which the rules at the vascular
# plants set from a taxon's phyllotaxis_pattern.
#
# Revision 3 (spec rework P6): a shoot is juvenile or adult (adult(0) or
# adult(1)), and only adult shoots fruit. Once the vine is adult_age old a
# free shoot is adult, as it fruited before, and so is a side shoot within
# reach of its host whose tip has at least adult_light of the open sky,
# as an ivy's flowering shoots stand out from its climbing stems where
# they reach the light; any other shoot is juvenile. adult_age, the first
# year the plant is adult, is the name the programs that measure it by
# the plant's age share, which the rule at the seed plants sets from a
# taxon's juvenile_period_years; it replaces fruit_age, with the same
# default. With adult_rise above 0 an adult shoot takes its own habit, as
# an ivy's does: it stays adult, no longer seeks or clings to its host,
# grows upward under a tropism of elasticity adult_rise in place of drape,
# does not stop after free_years, and its side shoots are adult. With
# adult_light above 1 and adult_rise 0, the defaults, a climber grows as
# before.
#
# Revision 4 (growth plan G2.3a): a starting base with no values. Each
# parameter given as a number is `param name;`, and the lineage programs
# that extend it (`hedera`, `vitaceae`) give the values their species
# leave unset, as this program's defaults were until then.
#
# Revision 5 (leaf life): leaves and fruit live as long as their
# parameters say, no longer one year more. What a step makes is born at
# the step's end, so a rule that ends a part by its age counts the step it
# is in (`age + dt >=`).
#
# Revision 6 (dioecy): in a dioecious species (dioecious 1, from the
# sexual system its taxa state) a plant whose own draw `sex` is below a
# half is male and bears no fruit. The rest are female and fruit as
# before; so does a plant that bears both sexes (dioecious 0).
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem climber 6;

param vigour_spread;
param shoots;                 # stems from the foot
param internode;
param max_shoot;              # most internodes a shoot grows in a year
param shade_shoot;            # share of them it grows in deep shade
param cling;                  # within this of the host a shoot clings
param hug;                    # how far a clinging shoot turns toward the host each internode
param climb;                  # upward tropism of a clinging shoot
param reach;                  # how far a shoot senses its host
param seek;                   # how far a shoot within reach turns toward the host
param drape;                  # downward tropism of a free shoot
param adult_rise;             # upward tropism of an adult shoot of its own habit; 0 none
param adult_light;            # least light at a tip in reach that makes it adult; over 1 never
param free_years;             # years a free shoot keeps growing
param branch_chance;          # chance of a side shoot at a node
param branch_angle;
param max_order;
param leaf_size;
param leaf_angle;
param divergence;             # roll from one node to the next
param leaf_years;
param renew;                  # chance a year that an old node leafs again
param adult_age;              # the first year the plant is adult and fruits
param fruiting;               # chance of a fruit cluster at a free node
param fruit_size;
param dioecious;              # 1: each plant is male or female; 0: every plant bears both
param sex;                    # this plant's own draw, 0 to 1: below a half, a dioecious plant is male
param leaf_area;
param fruit_area;
param pipe_tip;
param pipe_organ;
param pipe_rings;

module A(o, h, a) queries host, light;  # a shoot's tip: order, h years free, a 1 adult of its own habit
module S queries vigour;      # the foot of a side shoot
module M(n, o, w);            # n internodes still to lay this year; w 1 adult, 2 adult of its own habit
module Sh(k, m);              # shoots k to k + m - 1 from the foot

organ leaf leaf area leaf_area;
organ fruit fruit area fruit_area;

tool host@1 { reach = reach };
tool vigour@1 { lambda = 0.5, alpha = 2 };
tool light@1 { cell = 0.3, extinction = 0.5, bud = 0.01 };
tool pipe@1 { exponent = 2.4, tip = pipe_tip, organ = pipe_organ, rings = pipe_rings };

axiom Sh(0, max(1, round(shoots)));

decompose Sh(k, m) : m > 1 -> Sh(k, floor(m / 2)) Sh(k + floor(m / 2), m - floor(m / 2));
decompose Sh(k, m) : m == 1 ->
    [ /(k * 360 / max(1, shoots) + uniform(-20, 20)) &(uniform(20, 50)) S A(0, 0, 0) ];
decompose Sh(k, m) -> ;

# A shoot's tip: adult of its own habit, clinging, seeking or hanging
# free.
rule A(o, h, a) : h >= free_years -> ;
rule A(o, h, a) : adult_rise > 0
                  && (a > 0 || (t >= adult_age && (gd >= reach || (o > 0 && light >= adult_light)))) ->
    adult(1) T(0, 1, 0, adult_rise)
    M(max(1, round(max_shoot * lerp(shade_shoot, 1, light) * 0.5)), o, 2) A(o, 0, 1);
rule A(o, h, a) : gd < cling ->
    adult(o > 0 && t >= adult_age && light >= adult_light ? 1 : 0) steer(gx, gy, gz, hug) T(0, 1, 0, climb)
    M(max(1, round(max_shoot * lerp(shade_shoot, 1, light))), o,
      o > 0 && t >= adult_age && light >= adult_light ? 1 : 0) A(o, 0, 0);
rule A(o, h, a) : gd < reach ->
    adult(o > 0 && t >= adult_age && light >= adult_light ? 1 : 0) steer(gx, gy, gz, seek)
    M(max(1, round(max_shoot * lerp(shade_shoot, 1, light) * 0.5)), o,
      o > 0 && t >= adult_age && light >= adult_light ? 1 : 0) A(o, 0, 0);
rule A(o, h, a) ->
    adult(t >= adult_age ? 1 : 0) T(0, -1, 0, drape)
    M(max(1, round(max_shoot * lerp(shade_shoot, 1, light) * 0.5)), o, t >= adult_age ? 1 : 0)
    A(o, h + dt, 0);

# One internode with its leaf, and perhaps a side shoot or fruit.
decompose M(n, o, w) : n > 0 ->
    F(internode) /(divergence + gauss() * 10)
    [ &(leaf_angle) $ leaf(leaf_size * uniform(0.85, 1.15)) ]
    [ /(180) Lb ]
    Mb(o, w)
    M(n - 1, o, w);
decompose M(n, o, w) -> ;
module Mb(o, w);              # what a node may carry besides its leaf
module Lb;                    # a node's bud, which may leaf again
decompose Mb(o, w) : o < max_order && rand() < branch_chance ->
    [ /(uniform(0, 360)) &(branch_angle) S A(o + 1, 0, w > 1 ? 1 : 0) ];
decompose Mb(o, w) : w > 0 && rand() < fruiting && (dioecious < 0.5 || sex >= 0.5) ->
    [ &(150) fruit(fruit_size * uniform(0.8, 1.2)) ];
decompose Mb(o, w) -> ;

# Leaves fall after leaf_years, fruit after a year; a side shoot with no
# living tip falls.
rule leaf(s) : age + dt >= leaf_years -> ;
rule fruit(s) : age + dt >= 1 -> ;
rule S : age > 1 && ntip == 0 -> %;

# An old node leafs again.
rule Lb : age >= 1 && rand() < renew * dt -> [ &(leaf_angle) $ leaf(leaf_size * uniform(0.8, 1.1)) ] Lb;
