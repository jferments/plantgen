# The zamias and their kin (Zamiaceae), on the palm base (growth plan
# G2.3a): dioecious cycads, trees to 18 m with stems clothed in old leaf
# bases or with stems underground, pinnate leaves in a crown, and seeds in
# determinate cones (Mabberley 2017; Watson and Dallwitz). It gives the
# values its species leave unset, as Cycadaceae's program does for its
# own (a cycad's crown, croziers and boots).
#
# Revision 2: palm revision 9's trunk thickening, flushes, scale leaves,
# leaflet opening and boot angle come from the Cycadales and family rank
# files (Whitelock 2002), not from here; leaflet groups and coil_short
# are given as before (none).
#
# Revision 3: gives palm revision 11's crozier values: a zamiad's frond
# is not drawn coiled (coil_turns 0) until a taxon's vernation says how;
# a coiled piece's size, tightness, leaflet size and roll as the fern
# program's (`polypodiidae`).
# Revision 4: palm revision 12's cones by sex come from the Cycadales,
# family and genus rank files (Whitelock 2002): a male bears pollen cones,
# a female seed cones, each genus's own.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem zamiaceae 4 extends palm;

param vigour_spread = 0.1;
param upturn = 0;
param frond_seed = 0.15;
param frond_spread = 0.08;
param divergence = 137.5;
param angle_spread = 6;
param rays = 40;
param fan_spread = 200;
param fan_length = 0.5;
param fan_cup = 15;
param costa = 0;
param skirt = 0;
param dead_angle = 165;
param dead_life = 0;
param rest_gap = 0.02;
param flare = 0;             # the foot's extra girth, a share of trunk_radius
param flare_years = 1;
param bulge = 0;             # a belly's extra girth, a share of trunk_radius
param bulge_age = 0;
param bulge_years = 1;
param crownshaft = 0;        # a crownshaft's length; 0 none
param shaft_cards = 8; param sheath_area = 0.235;
param sheath_length = 0;     # no sheaths below a frond without a crownshaft
param leaflet_scatter = 0;   # degrees leaflets stand above and below their V
param fan_arch = 0;          # degrees a fan's edge rays droop below its middle
param hang = 0;              # degrees a frond turns down over its life
param leaflet_groups = 2;
param acanthophylls = 0;      # no spines among the leaflets
param spine_length = 0.1;
param spine_area = 0.004;
param coil_short = 0;
param coil_turns = 0;         # turns of a circinate frond's rachis in its crozier; 0 coils by curl
param coil_size = 0.22;       # a coiled piece's length at the crozier's outer turn, a share of its open length
param coil_tight = 2;         # how fast the coiled pieces shorten toward the tip
param coil_pinna = 0.12;      # a coiled leaflet at the outer turn, a share of its open size
param coil_roll = 0.08;       # a rolled leaflet's thickness, a share of its rolled length
