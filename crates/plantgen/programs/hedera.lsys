# Ivies (Hedera, Araliaceae), on the climber base (growth plan G2.3a). It
# gives the values its species leave unset (4 of climber's parameters), as
# the climber program's defaults until then; each species sets the rest.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem hedera 1 extends climber;

param vigour_spread = 0.1;
param shade_shoot = 0.4;   # share of them it grows in deep shade
param reach = 3;           # how far a shoot senses its host
param divergence = 137.5;  # roll from one node to the next
# A juvenile shoot is plagiotropic: it creeps and climbs over its support
# on its aerial roots in every direction, not straight up (FEIS, Waggy
# 2010, after Stein and Fosket 1969), so a clinging shoot's internodes
# turn about 30 degrees at random (climber revision 10). Hand-set, against
# photographs of ivy on walls (2026-11-01).
param wander = 30;
# A juvenile shoot lies pressed to its support by its aerial roots, its
# leaves held out on their stalks with the blades flat to the open side
# in a mosaic, as photographs of ivy on walls and trunks show (sites plan
# S4, 2026-11-01): a clinging shoot's leaves turn most of the way to face
# away from the support (climber revision 10). Hand-set.
param leaf_face = 0.8;
