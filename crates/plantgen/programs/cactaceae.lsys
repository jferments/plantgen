# The cacti (Cactaceae): their fleshy stems, after the Sonoran Desert's
# saguaros, organ pipes, barrels, hedgehogs, pincushions, chollas and
# prickly pears, on the column base. It gives the values its species leave
# unset, as this program's own were until then; its genera extend it where
# they grow otherwise.
#
# Revision 2 (spec rework M7): a bud is a flower, not a fruit.
#
# Revision 3 (growth plan G2.3a): the cacti's own program, renamed from
# `succulent` and homed at Cactaceae; its genera extend it where they
# grow otherwise. It grows every plant as before.
#
# Revision 4: a column's ring of flowers takes the radius at the foot of
# its newest piece, so a young pup's flowers sit on its body.
#
# Revision 5 (plants fitted to their place): a joint that sags to the
# ground lies on it, `rest_gap` above the substrate (substrate@1's, or
# level soil), as a prickly pear's pads do, instead of passing into it.
#
# Revision 6 (dioecy): in a dioecious species (dioecious 1, from the
# sexual system its taxa state) a plant whose own draw `sex` is below a
# half is male: its rings bear open flowers where a female's bear fruit,
# and its joints hang no chains of fruit. The rest are female and fruit as
# before; so does a plant that bears both sexes (dioecious 0).
#
# Revision 7 (growth plan G2.3a, big families): the body moves to the
# column base, which the succulent spurges and stapeliads share; this
# program keeps the cacti's values. It grows every plant as before.
#
# Revision 8 (thread "Cacti"): on column revision 2; one ring in the
# crown, as before, unless a species asks for more (crown_rings).
#
# The plant frame's +Z is south. One step is one year. Angles are degrees;
# lengths are metres.

lsystem cactaceae 8 extends column;

param vigour_spread = 0.12;   # an individual grows exp(gauss() * vigour_spread) times as fast
param lean = 3;               # most degrees a lone stem leans at its foot, in a random direction
param sink = 0;               # how deep the stems' feet sit below the ground
param stems = 1;              # stems in an old clump
param stem_rate = 0.05;       # stems by age t: 1 + (stems - 1) * (1 - exp(-stem_rate * t))
param clump_radius = 0;       # radius the feet of an old clump's stems spread over
param stem_lean = 0;          # how far the outermost stems lean out at their feet
param seedling = 0.006;       # height a seedling reaches in its first years
param height_max = 10;
param height_rate = 0.012;
param height_shape = 3;
param radius_min = 0.004;     # radius of a seedling's tip
param radius_max = 0.25;      # radius of an adult's tip
param radius_height = 0.8;    # the tip widens over about this much height
param fill = 0.9;             # old pieces fill out to fill * radius_max...
param fill_years = 25;        # ...over about this many years
param pinch = 0;              # chance a year's piece is pinched by a hard year
param pinch_depth = 0.12;     # how much narrower a pinched piece is
param wiggle = 0.5;           # spread of the random turn of a piece 10 cm long
param sun_tilt = 0;           # tilt toward the south a column turns to
param bend = 0.05;            # how fast it turns there, radians a metre
param arm_rate = 0;           # arms a year a mature column sprouts, on average
param arm_spread = 0.6;       # individuals sprout exp(gauss() * arm_spread) times as many
param arm_age = 60;           # the first year a column may sprout arms
param arm_height = 2.5;       # and the least height it must have
param arm_low = 0.3;          # arms sprout between arm_low and arm_high of the height
param arm_high = 0.75;
param arm_angle = 80;         # angle an arm leaves the column at, from its axis
param arm_out = 0.6;          # share of the column's radius out from its axis an arm starts
param arm_length = 5;         # arm length l(a) = richards(a v, arm_length, arm_growth, arm_shape)
param arm_growth = 0.02;
param arm_shape = 1.2;
param arm_radius = 0.8;       # an arm's girth as a share of radius_max
param arm_neck = 0.65;        # its girth where it leaves the column, as a share of its own
param arm_neck_length = 0.12; # how far out the neck widens
param elbow = 4;              # how fast an arm turns up, radians a metre
param elbow_spread = 0.35;    # arms turn exp(gauss() * elbow_spread) times as fast
param droop = 0;              # share of arms that hang down and curl back up
param droop_length = 1;       # how far a drooping arm hangs before it curls up
param joints = 0;             # 1: stems are chains of joints
param joint_length = 0.12;    # a joint's length
param joint_radius = 0.02;    # its radius, or a pad's half width
param joint_spread = 0.25;    # joints are joint_length * (1 ± joint_spread) long
param pad = 0;                # 1: a joint is a flat, obovate pad; 0: a club
param bud_rate = 1;           # chance a year that a lateral joint not yet sprouted sprouts
param daughters_low = 0.6;    # a joint sprouts uniform(daughters_low, daughters_high)
param daughters_high = 2.6;   # daughters, the share (1 - (d - 1) / generations) of them
param generations = 8;        # at depth d in a branch
param branch_angle = 35;      # angle a club joint's daughter leaves its axis at
param margin = 55;            # spread of a pad's daughters round its top, from its tip
param twist = 35;             # spread of a daughter's roll out of its parent's plane
param trunk_joints = 0;       # joints of a trunk, each continuing the one before
param leader_lean = 6;        # most degrees a trunk joint tilts from the one before
param resprout = 0;           # chance a year a trunk joint in the crown sprouts a lateral
param crown = 0.5;            # share of the plant's height, from the top, that resprouts
param sag = 0.3;              # how fast joints bend down, radians a metre
param rest_gap = 0.02;        # a joint that reaches the ground lies this far above it
param joint_life = 0;         # years a lateral joint lives before it falls; 0 for ever
param swell = 0;              # an old trunk joint grows (1 + swell) times as thick...
param swell_years = 15;       # ...over about this many years
param swell_side = 0.5;       # a lateral at depth d swells swell_side^d as much
param dome = 1;               # the look's dome, in radii of the tip: where rings and pads' daughters sit
param bloom_age = 30;         # the plant's first year in flower
param flowers = 0;            # flowers, buds and fruit in a ring round each column's tip
param ring_angle = 40;        # where the ring sits on the dome, degrees from the tip
param flower_angle = 35;      # angle a flower stands out from the column's axis
param flower_size = 0.08;
param bud_share = 0.25;       # share of the ring in bud
param fruit_share = 0.25;     # share in fruit
param bud_size = 0.03;
param fruit_size = 0.06;
param joint_flowers = 0;      # flowers along the top of each of the youngest joints
param chains = 0;             # share of joints that hang a chain of fruit
param chain_max = 7;          # most fruit in a chain
param flower_area = 0.64;
param bud_area = 0.89;
param fruit_area = 0.89;
param crown_rings = 1;        # rings round a column's tip: this year's, then older rings of fruit
param ring_step = 15;         # degrees each older ring sits below the one above
