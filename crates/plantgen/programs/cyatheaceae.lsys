# Tree ferns (Cyatheaceae, with Dicksonia), on the palm base (growth plan
# G2.3a). It gives the values its species leave unset (23 of palm's
# parameters), as the palm program's defaults until then; each species
# sets the rest.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem cyatheaceae 1 extends palm;

param vigour_spread = 0.1;   # a palm grows exp(gauss() * vigour_spread) times as fast
param upturn = 0;            # how strongly a leaning trunk turns back up, radians a metre
param frond_seed = 0.15;     # a seedling's fronds, as a share of full size
param frond_spread = 0.08;   # fronds are l (1 ± frond_spread) long
param divergence = 137.5;    # roll from one frond to the next
param angle_spread = 6;
param leaflet_area = 0.1;    # leaf area of a leaflet 1 m long, m²
param rays = 40;             # segments of a fan
param fan_spread = 200;      # degrees the segments spread over
param fan_length = 0.5;      # a segment, as a share of the frond's length
param fan_cup = 15;          # degrees the fan's segments rise into a shallow cup
param costa = 0;             # share of the frond's length along which the rays rise from a rib
param boots = 0;             # 1: a fallen frond leaves its boot
param boot_life = 10;        # years a boot stays
param boot_length = 0.25;    # a boot, metres
param boot_area = 0.2;
param crown_cone = 0;        # length of a cone at the crown's centre; 0 none
param adult_age = 10;        # the first year the plant is adult and bears one
param cone_area = 0.6;
param suckers = 0;
param sucker_age = 5;
param sucker_rate = 0.3;
param sucker_distance = 0.4;
