# Palm: one trunk (or a clump of them) under a spiral crown of large
# fronds, after the fan and feather palms, cycads and tree ferns. Each year
# a crown adds fronds_per_year fronds on a golden-angle spiral, each a
# little above the last, and its trunk grows trunk_rate metres a year once
# the palm has built its girth underground (stemless_years: until then
# the crown sits on the ground and the trunk grows only a share of its
# rate, rising smoothly to all of it). A palm's trunk keeps its girth
# (trunk_radius): palms do not thicken with age.
#
# A frond is a petiole (petiole of its length) and a rachis of `pieces`
# pieces:
#
# - a feather frond (fan 0) carries a pair of leaflets at each half piece,
#   longest at leaflet_peak along the rachis, raised leaflet_lift degrees
#   into a V;
# - a fan frond (fan 1) carries, at the petiole's tip, `rays` segments
#   spread over fan_spread degrees, each a blade fan_length of the frond
#   long, its tip bent down by the blade's own bend; a costapalmate fan
#   (as in the cabbage palm) has a short rachis (costa) the rays follow.
#
# A frond unrolls as a fern's does (`polypodiidae`): emerging at a phase e of the
# year, it has unrolled the share u = clamp((age + season - e) / unroll,
# 0, 1) at the keyframe, each piece beyond u coiling back by up to `curl`
# degrees (set curl 0 for a palm, whose spear opens without coiling). It
# opens from young_angle off the vertical toward old_angle as it ages and
# sags under a tropism toward the ground of elasticity
# droop * min(a, droop_years), so the oldest living fronds hang lowest.
# After frond_life years a frond dies: it falls (skirt 0) or hangs dead
# against the trunk at dead_angle (skirt 1, the petticoat of a fan palm or
# a tree fern) for dead_life years. A fallen frond may leave its boot, the
# split base of its petiole, on the trunk for boot_life years (boots 1).
#
# A crown may bear a cone at its centre (crown_cone > 0, a cycad) and send
# up suckers from its foot like a rosette's pups: from sucker_age, with the
# chance sucker_rate a year, at most `suckers` of them, sucker_distance
# out. A leaning trunk (lean, upturn) turns back toward the sky; a creeping
# palm (lean near 90) runs along the ground with its crown raised.
#
# Revision 2 (spec rework M7): each frond is drawn within a `frond`
# structure: a feather frond's leaflets are leaflets of it, and a fan's
# rays, the dead frond hanging and the boot are pieces of it.
#
# Revision 3 (spec rework P6): the first year the plant is adult, from
# which it bears a cone, is adult_age, the name the programs that measure it
# by the plant's age share, which the rule at the seed plants sets from
# a taxon's juvenile_period_years. It replaces cone_age, with the same
# default.
#
# Revision 4 (growth plan G2.3a): a starting base with no values. Each
# parameter given as a number is `param name;`, and the lineage programs
# that extend it (`arecaceae`, `cyatheaceae`, `cycadaceae`) give the
# values their species leave unset, as this program's defaults were until
# then.
#
# Revision 5 (plants fitted to their place): a frond that sags to the
# ground lies on it, `rest_gap` above the substrate (substrate@1's, or
# level soil), instead of passing into it.
#
# Revision 6 (leaf life): fronds, dead fronds, boots and the crown's cone
# live as long as their parameters say, no longer one year more. What a
# step makes is born at the step's end, so a rule that ends a part by its
# age counts the step it is in (`age + dt >=`).
#
# Revision 7 (palms from their facts): a trunk's girth follows its
# life, a crownshaft stands under the crown, feather fronds' leaflets
# stand in two planes, a fan's segments arch down to its edges, and old
# fronds hang. Where a segment of trunk forms when its crown is a years
# old, its radius is trunk_radius times 1 + flare * exp(-a' / flare_years)
# (a' the years since the stemless ones: the swollen foot of a royal or a
# fan palm) + bulge * exp(-((a - bulge_age) / bulge_years)^2) (the royal
# palm's belly, or a bottle palm's). A crownshaft (crownshaft > 0, the
# royal palm's green column of leaf sheaths) is drawn as shaft_cards
# sheaths round the trunk's top, crownshaft long, each year's living as
# long as its fronds, and the fronds rise from its top. A feather frond's
# leaflets rise leaflet_lift ± leaflet_scatter degrees, the two halves of
# each piece in turn, so a plumose frond's stand in two planes. A fan's
# rays droop by up to fan_arch degrees toward its edges, as a costapalmate
# fan arches over its rib. A frond turns hang degrees further from the
# vertical over its life, so the oldest hang below the crown. Each at 0
# draws as revision 6 did.
#
# Revision 8 (a crownshaft's sheaths are its fronds'): each frond draws
# its own sheath, within its `frond` structure, as a palm's leaf sheath is
# the base of its leaf: max(1, round(shaft_cards / fronds_per_year))
# cards round the crownshaft's core, from the frond's foot down the
# crownshaft's length, living and dying with the frond. Until revision 7
# a year's sheaths stood round the trunk's top within no structure, which
# the organ check refuses for a piece.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem palm 8;

# The plant.
param vigour_spread;          # a palm grows exp(gauss() * vigour_spread) times as fast
param lean;                   # most degrees the trunk leans at its foot
param upturn;                 # how strongly a leaning trunk turns back up, radians a metre
# The trunk.
param trunk_rate;             # metres a year once established
param trunk_radius;
param stemless_years;         # years before the trunk rises at its full rate
param internode;              # trunk between one frond and the next
param flare;                  # the foot's extra girth, a share of trunk_radius
param flare_years;            # years over which the foot's flare narrows to the trunk
param bulge;                  # a belly's extra girth, a share of trunk_radius
param bulge_age;              # the crown's age when the belly's widest part forms
param bulge_years;            # how long the belly lasts, years either side
param crownshaft;             # a crownshaft's length, metres; 0 none
param shaft_cards;            # sheaths drawn round it
param sheath_area;            # leaf area of a sheath 1 m long, m²
# Fronds.
param fronds_per_year;
param frond_life;             # years a frond lives
param frond_length;           # a full-size frond, petiole included
param frond_seed;             # a seedling's fronds, as a share of full size
param size_years;             # fronds reach full size over about this many years
param frond_spread;           # fronds are l (1 ± frond_spread) long
param divergence;             # roll from one frond to the next
param young_angle;            # angle of a new frond to the vertical
param old_angle;              # the angle an old frond opens to
param open_years;             # how fast a frond opens, years
param angle_spread;
param petiole;                # share of the frond's length that is petiole
param petiole_radius;         # its radius
param pieces;                 # pieces of the rachis
# Feather fronds.
param fan;                    # 1: a fan frond
param leaflet_length;         # the longest leaflet, as a share of the frond's length
param leaflet_peak;           # where it sits along the rachis, 0 to 1
param leaflet_base;           # the lowest leaflet, as a share of the longest
param leaflet_tip;            # the topmost leaflet, as a share of the longest
param leaflet_angle;          # angle of a leaflet to the rachis
param leaflet_lift;           # degrees the leaflets rise into a V
param leaflet_scatter;        # degrees the two halves of a piece's leaflets stand above and below it
param leaflet_area;           # leaf area of a leaflet 1 m long, m²
# Fan fronds.
param rays;                   # segments of a fan
param fan_spread;             # degrees the segments spread over
param fan_length;             # a segment, as a share of the frond's length
param fan_cup;                # degrees the fan's segments rise into a shallow cup
param costa;                  # share of the frond's length along which the rays rise from a rib
param fan_arch;               # degrees a fan's edge rays droop below its middle
param ray_area;               # leaf area of a segment 1 m long, m²
# Unrolling, sagging and dying.
param season;                 # share of the year at the keyframe
param emerge_spread;          # fronds emerge over this share of the year
param unroll;                 # share of a year a frond takes to open
param curl;                   # degrees each coiled piece turns back
param droop;                  # sag per year of a frond's age
param droop_years;
param hang;                   # degrees a frond turns further from the vertical over its life
param rest_gap;               # a frond that reaches the ground lies this far above it
param skirt;                  # 1: dead fronds hang
param dead_angle;             # angle of a hanging dead frond to the vertical
param dead_life;              # years a dead frond hangs
param dead_area;              # leaf area of a dead frond 1 m long
param boots;                  # 1: a fallen frond leaves its boot
param boot_life;              # years a boot stays
param boot_length;            # a boot, metres
param boot_area;
# A cone and suckers.
param crown_cone;             # length of a cone at the crown's centre; 0 none
param adult_age;              # the first year the plant is adult and bears one
param cone_area;
param suckers;
param sucker_age;
param sucker_rate;
param sucker_distance;

module Y(v, n);               # a crown: vigour, suckers so far
module Fc(i, m, c, r);        # fronds i to i + m - 1 of this year's cohort, on a crown c years old, round a crownshaft r in radius
module Fr(s, a, e, r);        # a frond s long at a degrees, emerging at phase e of its year, its sheath round a crownshaft r in radius
module Pc(k, m, s, e);        # pieces k to k + m - 1 of a frond's rachis
module Pp(k, s, e);           # a drawn piece of a rachis
module Ln(k, s, e, h);        # a pair of leaflets h of a piece along piece k
module Lq(z, w);              # a pair of leaflets z long, raised w (1 or -1) times leaflet_scatter
module Ry(j, m, s, e);        # rays j to j + m - 1 of a fan
module Dh(s);                 # a dead frond hanging
module Bt;                    # a boot
module Cc(z);                 # the crown's cone, z long
module Sb(n);                 # the plant's foot: suckers sent out so far
module Sk(n);                 # a sucker on its runner, the n-th
module Sh(z, r);              # a sheath card of the crownshaft, z long, round a core r in radius
module Sc(z);                 # the crownshaft's core, z long

organ leaflet leaf as leaflet area leaflet_area;
organ ray leaf as piece area ray_area;
organ dead leaf as piece area dead_area;
organ boot leaf as piece area boot_area;
organ cone cone area cone_area;
organ sheath leaf as piece area sheath_area;

structure frond leaf;         # one frond: its sheath, petiole, rachis, leaflets or rays, then its dead frond and boot

axiom [ Sb(0) ] /(uniform(0, 360)) &(uniform(0, lean)) Y(exp(gauss() * vigour_spread), 0);

# The crown: the trunk's growth and this year's fronds.
# A crownshaft palm's fronds and cone stand on the shaft's core, which
# lives as long as they do; each frond's sheath clasps the core below it.
rule Y(v, n) : crownshaft > 0 ->
    !(trunk_radius
      * (1 + flare * exp(-max(0, age - stemless_years) / max(flare_years, 0.001))
         + (bulge > 0 ? bulge * exp(-pow((age - bulge_age) / max(bulge_years, 0.001), 2)) : 0)))
    T(0, 1, 0, upturn * trunk_rate * v)
    F(trunk_rate * v * smoothstep(0, stemless_years, age))
    [ Sc(crownshaft) Fc(0, max(1, round(fronds_per_year * v)), age * v, trunk_radius
          * (1 + flare * exp(-max(0, age - stemless_years) / max(flare_years, 0.001))
             + (bulge > 0 ? bulge * exp(-pow((age - bulge_age) / max(bulge_years, 0.001), 2)) : 0)))
      [ Cc(age >= adult_age ? crown_cone : 0) ] ] Y(v, n);
rule Y(v, n) ->
    !(trunk_radius
      * (1 + flare * exp(-max(0, age - stemless_years) / max(flare_years, 0.001))
         + (bulge > 0 ? bulge * exp(-pow((age - bulge_age) / max(bulge_years, 0.001), 2)) : 0)))
    T(0, 1, 0, upturn * trunk_rate * v)
    F(trunk_rate * v * smoothstep(0, stemless_years, age))
    Fc(0, max(1, round(fronds_per_year * v)), age * v, 0)
    [ Cc(age >= adult_age ? crown_cone : 0) ] Y(v, n);

# The foot sends up suckers.
rule Sb(n) : suckers > n && t >= sucker_age && rand() < sucker_rate -> [ Sk(n + 1) ] Sb(n + 1);

# This year's fronds, a little apart up the trunk, each turned on round
# the spiral.
decompose Fc(i, m, c, r) : m > 1 ->
    Fc(i, floor(m / 2), c, r) Fc(i + floor(m / 2), m - floor(m / 2), c, r);
decompose Fc(i, m, c, r) : m == 1 ->
    !(trunk_radius) F(internode) /(divergence + gauss() * 3)
    [ Fr(frond_length * (frond_seed + (1 - frond_seed) * (1 - exp(-c / size_years)))
         * uniform(1 - frond_spread, 1 + frond_spread),
         gauss() * angle_spread, uniform(0, emerge_spread), r) ];
decompose Fc(i, m, c, r) -> ;

# A frond dies after frond_life years: it hangs, or falls and leaves its
# boot, or falls. The first piece stands for the frond; the others go.
rule Pc(k, m, s, e) : age + dt >= frond_life && k == 0 && skirt > 0 -> Dh(s);
rule Pc(k, m, s, e) : age + dt >= frond_life && k == 0 && boots > 0 -> Bt;
rule Pc(k, m, s, e) : age + dt >= frond_life -> ;
rule Dh(s) : age + dt >= dead_life && boots > 0 -> Bt;
rule Dh(s) : age + dt >= dead_life -> ;
rule Bt : age + dt >= boot_life -> ;
# The frond holds its dead frond and boot until they go: a generous bound,
# since what is gone leaves nothing within it.
rule frond : age >= frond_life + dead_life + boot_life + 4 * dt -> ;
interpret Dh(s) -> &(dead_angle) dead(s);
interpret Bt -> &(60) boot(boot_length);

# A frond: its petiole, then its rachis piece by piece, and a fan frond's
# rays at the end. The rays share the frond's birth, so they die with it.
decompose Fr(s, a, e, r) : crownshaft > 0 && fan > 0 ->
    frond [ ring(max(1, round(shaft_cards / max(1, fronds_per_year)))) [ Sh(crownshaft, r) ] ]
    Pc(0, max(1, round(pieces)), s, e) Ry(0, max(1, round(rays)), s, e);
decompose Fr(s, a, e, r) : crownshaft > 0 ->
    frond [ ring(max(1, round(shaft_cards / max(1, fronds_per_year)))) [ Sh(crownshaft, r) ] ]
    Pc(0, max(1, round(pieces)), s, e);
decompose Fr(s, a, e, r) : fan > 0 -> frond Pc(0, max(1, round(pieces)), s, e) Ry(0, max(1, round(rays)), s, e);
decompose Fr(s, a, e, r) -> frond Pc(0, max(1, round(pieces)), s, e);
decompose Ry(j, m, s, e) : m > 1 ->
    Ry(j, floor(m / 2), s, e) Ry(j + floor(m / 2), m - floor(m / 2), s, e);
rule Ry(j, m, s, e) : age + dt >= frond_life -> ;
decompose Pc(k, m, s, e) : m > 1 ->
    Pc(k, floor(m / 2), s, e) Pc(k + floor(m / 2), m - floor(m / 2), s, e);

# The first piece opens the frond, sets its sag and draws the petiole.
interpret Pc(k, m, s, e) : k == 0 ->
    &(lerp(young_angle, old_angle, 1 - exp(-max(0, age + season - e) / open_years))
      + hang * clamp((age + season - e) / max(frond_life, 0.001), 0, 1))
    T(0, -1, 0, droop * min(max(0, age + season - e), droop_years)) rest(rest_gap)
    !(petiole_radius) F(s * petiole) !(petiole_radius * 0.6) Pp(k, s, e);
interpret Pc(k, m, s, e) -> Pp(k, s, e);

# A piece of a fan frond's costa, its last piece the fan; a piece of a
# feather frond with two pairs of leaflets. A piece beyond the unrolled
# share coils back.
interpret Pp(k, s, e) : fan > 0 -> F(s * costa / max(1, pieces));
interpret Pp(k, s, e) ->
    ^(curl * smoothstep(0, 0.15, (k + 0.5) / pieces - clamp((age + season - e) / unroll, 0, 1)))
    F(s * (1 - petiole) / pieces * 0.5) Ln(k, s, e, 0)
    F(s * (1 - petiole) / pieces * 0.5) Ln(k, s, e, 0.5);

# A pair of leaflets, sized along the rachis, small while the frond opens.
interpret Ln(k, s, e, h) ->
    Lq(s * leaflet_length
       * ((k + h) / pieces < leaflet_peak
          ? lerp(leaflet_base, 1, (k + h) / pieces / leaflet_peak)
          : lerp(1, leaflet_tip, ((k + h) / pieces - leaflet_peak) / (1 - leaflet_peak)))
       * lerp(0.3, 1, clamp((age + season - e) / unroll, 0, 1)),
       h > 0 ? -1 : 1);
interpret Lq(z, w) ->
    [ +(leaflet_angle) ^(leaflet_lift + leaflet_scatter * w) leaflet(z) ]
    [ -(leaflet_angle) ^(leaflet_lift + leaflet_scatter * w) leaflet(z) ];

# A fan's ray j of m: each from the fan's centre at the rachis' end, spread
# across the frond's plane and cupped up a little, longest in the middle;
# folded together while the frond opens.
interpret Ry(j, m, s, e) ->
    [ +(fan_spread * clamp((age + season - e) / unroll, 0.15, 1)
        * ((j + 0.5) / max(1, round(rays)) - 0.5))
      ^(fan_cup - fan_arch * 2 * abs((j + 0.5) / max(1, round(rays)) - 0.5)) ray(s * fan_length * (0.7 + 0.3 * sin(pi * (j + 0.5) / max(1, round(rays))))) ];

# The crown's cone, at its centre among the young fronds; a crown bears
# the newest only.
decompose Cc(z) : z <= 0 -> ;
rule Cc(z) : age + dt >= 1 -> ;
interpret Cc(z) -> cone(z);

# A sheath card of the crownshaft: out to the core's surface, then down
# it from the frond's foot. It lives as long as its frond.
rule Sh(z, r) : age + dt >= frond_life -> ;
interpret Sh(z, r) -> +(90) f(r) +(90) sheath(z);
rule Sc(z) : age + dt >= frond_life -> ;
interpret Sc(z) -> !(trunk_radius * 0.97) F(z);

# A sucker: out along a runner at the foot, then up, a palm of its own.
decompose Sk(n) ->
    /(uniform(0, 360)) &(90) f(sucker_distance * uniform(0.6, 1.4)) ^(90)
    /(uniform(0, 360)) &(uniform(0, lean)) Y(exp(gauss() * vigour_spread), n);
