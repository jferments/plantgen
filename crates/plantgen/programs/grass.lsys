# Bunchgrass: a tussock of tillers. Each year the crown sends up a new
# cohort of tillers on a sunflower spiral; their number and the width of
# the tussock grow with age, and the outer tillers lean out. A tiller
# carries a few arching leaf blades. In a plant old enough to flower, some
# tillers raise a culm with a leaf at each node and a panicle at the top;
# a branching grass's culms send branch culms from some nodes (revision 9).
# The next year the cohort is dead: its blades stay on as straw-coloured
# thatch that has lost its tips and flops outward, its culms are gone, and
# a year later the thatch is gone too.
#
# A blade is a chain of pieces, each 12% shorter than the one before. The
# blade template narrows by 12% along one piece, so the pieces join without
# a step, and the blade tapers to its tip. A blade bends down at every
# joint and twists a little.
#
# Revision 2 (phyllotaxis P1): a tiller's blades and a culm's leaves turn
# divergence degrees from one to the next (180: two ranks, as in grasses;
# 120: three, as in sedges), the name every leaf-bearing program shares,
# which the rules at the vascular plants set from a taxon's
# phyllotaxis_pattern.
#
# Revision 3 (spec rework M7): each blade is drawn within a `leaf`
# structure, and its pieces, tip and thatch are pieces of it, so a grown
# grass knows which pieces make one leaf.
#
# Revision 4 (spec rework P6): the first year the plant is adult, from
# which it flowers, is adult_age, the name the programs that measure it
# by the plant's age share, which the rule at the seed plants sets from
# a taxon's juvenile_period_years. It replaces flower_age, with the same
# default.
#
# Revision 5 (growth plan G2.3a): a starting base with no values. Each
# parameter given as a number is `param name;`, and the lineage programs
# that extend it (`poaceae`, `juncaceae`, `carex`, `schoenoplectus`) give
# the values their species leave unset, as this program's defaults were
# until then.
#
# Revision 6 (spec rework E2): how far a blade's roll strays from its
# rank is roll_spread, which each lineage gives: a grass's two ranks
# hold closely, so Poaceae gives a small one, and the other lineages keep
# the 40 degrees all grew with until then. A culm leaf strays three
# quarters as far, the 30 degrees it had.
#
# Revision 7 (dioecy): in a dioecious species (dioecious 1, from the
# sexual system its taxa state) a plant whose own draw `sex` is below a
# half is male, and its culms bear male panicles (`panicle_male`), drawn
# as its panicles are in flower and gone where they would be in fruit.
# The rest are female and bear panicles as before; so does a plant that
# bears both sexes (dioecious 0). The male panicle's nod is worked out
# from the culm, with no random draw, so every other draw stays where it
# was.
#
# Revision 8: a blade may stay green past its first year. It turns to
# thatch after leaf_years (2 for a wintergreen grass, rush or sedge, whose
# blades of last year stay green through winter beside this year's), and
# its thatch stays thatch_years - 1 more as before. With leaf_years 1, as
# every program gives it unless a rule says otherwise, a grass grows as
# before.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem grass 9;

param tillers;                # living tillers in a mature tussock
param tiller_rate;            # cohort size: tillers * (1 - exp(-tiller_rate * age))
param tussock_radius;         # radius of a mature tussock's base
param tiller_lean;            # how far the outermost tillers lean out
param leaves;                 # blades on a tiller, give or take one
param leaf_length;            # mean blade length at maturity
param leaf_spread;            # blades are leaf_length * (1 ± leaf_spread)
param leaf_angle;             # mean angle of a blade to its tiller at the base
param divergence;             # roll from one blade or culm leaf to the next
param roll_spread;            # most a blade's roll strays from divergence, either way
param arch;                   # mean degrees a blade bends down at each joint
param twist;                  # spread of the random roll at each joint
param pieces;                 # pieces in a blade, its tip included
param maturity;               # years over which blades and culms reach full size
param adult_age;              # the first year the plant is adult and flowers
param flowering;              # share of tillers that flower
param culm_height;            # culm height at maturity, panicle included
param culm_radius;
param culm_leaves;            # leaves on a culm
param culm_lean;              # most a culm leans off its tiller
param panicle_length;
param dioecious;              # 1: each plant is male or female; 0: every plant bears both
param sex;                    # this plant's own draw, 0 to 1: below a half, a dioecious plant is male
param panicle_nod;            # degrees a panicle tips over
param culm_branches = 0;      # chance a culm node sends out a branch culm with its own panicle
param leaf_years = 1;         # years a blade stays green: more than 1 for wintergreens
param thatch_years;           # years dead blades stay on
param thatch_droop;           # extra degrees a dead blade bends at each joint
param light_cell;             # light voxel edge: about a blade's spacing
# Leaf area of each organ 1 m long, m². Match each to the area its look
# draws (`plantc atlas`).
param blade_area;
param tip_area;
param thatch_area;
param panicle_area;

module Y;                     # the crown: sends up a cohort each year
module Ts(k, m, n);           # tillers k to k + m - 1 of a cohort of n
module Tl;                    # the base of a tiller
module Lv(j);                 # j blades still to place on a tiller
module Bl(len, a);            # a blade len long bending a at each joint
module Pc(k, s, a);           # piece k of a blade, s long
module Bd(a);                 # the joint between two pieces
module Fl;                    # where a tiller may raise a culm
module Cm;                    # the base of a culm
module Cu(s, j);              # a culm: j leaves still to place, s between nodes
module Cn(s, j);              # a branching culm's node: its internode and leaf
module Cb(s, j);              # where a culm node may send out a branch culm

organ blade leaf as piece area blade_area;
organ blade_tip leaf as piece area tip_area;
organ thatch leaf as piece area thatch_area;
organ panicle flower area panicle_area;
organ panicle_male flower area panicle_area;

structure leaf leaf;          # one leaf: its blade's pieces, later its thatch

tool light@1 { cell = light_cell, extinction = 0.5 };

axiom Y;

# The cohort grows toward full size with the plant's age; t is the age the
# cohort is drawn at.
rule Y -> Ts(0, -1, 0) Y;
decompose Ts(k, m, n) : m < 0 ->
    Ts(0, max(1, round(tillers * (1 - exp(-tiller_rate * t)))),
          max(1, round(tillers * (1 - exp(-tiller_rate * t)))));
decompose Ts(k, m, n) : m > 1 ->
    Ts(k, floor(m / 2), n) Ts(k + floor(m / 2), m - floor(m / 2), n);
# One tiller: out along the sunflower spiral, up, and leaning out.
decompose Ts(k, m, n) : m == 1 ->
    [ Tl /(k * 137.508 + uniform(-12, 12)) &(90)
      f(tussock_radius * sqrt(n / tillers) * sqrt((k + uniform(0.2, 0.8)) / n)) ^(90)
      &(tiller_lean * sqrt((k + 0.5) / n) + uniform(0, 4))
      Lv(floor(uniform(leaves - 0.5, leaves + 1.5))) Fl ];
decompose Ts(k, m, n) -> ;

decompose Lv(j) : j > 0 ->
    [ /(j * divergence + uniform(-roll_spread, roll_spread)) &(leaf_angle * uniform(0.4, 1.6)) $
      Bl(leaf_length * (1 - exp(-t / maturity)) * uniform(1 - leaf_spread, 1 + leaf_spread),
         arch * uniform(0.5, 1.5)) ]
    Lv(j - 1);
decompose Lv(j) -> ;

# The pieces' lengths fall by 0.88 each, so the first is
# len * 0.12 / (1 - 0.88^pieces).
decompose Bl(len, a) -> leaf Pc(0, len * 0.12 / (1 - pow(0.88, pieces)), a);
decompose Pc(k, s, a) : k < pieces - 1 -> blade(s) f(s) Bd(a) Pc(k + 1, s * 0.88, a);
decompose Pc(k, s, a) -> blade_tip(s);
interpret Bd(a) -> /(gauss() * twist) &(a + thatch_droop * min(max(age - leaf_years + 1, 0), 1));

# A flowering tiller's culm: a leaf at each node, the panicle at the top.
decompose Fl : t >= adult_age && rand() < flowering ->
    [ Cm /(uniform(0, 360)) &(uniform(0, culm_lean)) !(culm_radius)
      Cu((culm_height * (1 - exp(-t / maturity)) * uniform(0.85, 1.15)
          - panicle_length * (1 - exp(-t / maturity))) / (culm_leaves + 1),
         culm_leaves) ];
decompose Fl -> ;
decompose Cu(s, j) : culm_branches > 0 && j > 0 -> Cn(s, j) Cb(s, j) Cu(s, j - 1);
decompose Cu(s, j) : j > 0 ->
    F(s) [ /(j * divergence + 0.75 * uniform(-roll_spread, roll_spread)) &(leaf_angle * 1.5) $
           Bl(leaf_length * (1 - exp(-t / maturity)) * uniform(0.35, 0.6), arch) ]
    Cu(s, j - 1);
decompose Cu(s, j) : dioecious >= 0.5 && sex < 0.5 ->
    F(s) &(panicle_nod * (0.5 + frac(s * 7.31 + j * 0.618)))
    panicle_male(panicle_length * (1 - exp(-t / maturity)));
decompose Cu(s, j) -> F(s) &(panicle_nod * uniform(0.5, 1.5))
                      panicle(panicle_length * (1 - exp(-t / maturity)));

# A year on, the cohort is dead: its blades become thatch without their
# tips, and its culms fall. After thatch_years as thatch it is gone.
rule blade(s) : age + dt >= leaf_years -> thatch(s);
rule blade_tip(s) : age + dt >= leaf_years -> ;
rule Cm -> %;
rule Tl : age >= thatch_years + leaf_years - 1 -> %;

# A branching culm (bush muhly, big galleta) sends a shorter branch culm
# from some of its nodes, leaning out, with fewer leaves and a panicle of
# its own. Its node is a rule of its own above, with no draws, so a grass
# whose culms do not branch grows by the old node rule unchanged; the
# draws are here at the end, so they never move the sites of those above.
decompose Cn(s, j) ->
    F(s) [ /(j * divergence + 0.75 * uniform(-roll_spread, roll_spread)) &(leaf_angle * 1.5) $
           Bl(leaf_length * (1 - exp(-t / maturity)) * uniform(0.35, 0.6), arch) ];
decompose Cb(s, j) : culm_branches > 0 && j > 1 && rand() < culm_branches ->
    [ /(j * divergence + 180 + uniform(-40, 40)) &(uniform(25, 45)) !(culm_radius * 0.7) Cu(s * 0.8, j - 1) ];
decompose Cb(s, j) -> ;
