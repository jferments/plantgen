# Herb: a clump of leafy stems from a perennial crown, after the forbs of
# meadows, clearings and forest floors. Each year the crown sends up a new
# cohort of stems on a sunflower spiral, more of them and spread wider as
# the clump ages, and last year's stems are gone. A stem has basal leaves
# at its foot, leaves along its lower part, alternate in a spiral or in
# opposite pairs, and a raceme at its top that opens from the bottom up:
# fruit below, open flowers in the middle, buds above, the bud-tipped end
# nodding over. A plant younger than adult_age grows short stems without
# a raceme.
#
# A basal leaf is one card or, with basal_pieces above 1, an arching strap
# of pieces like a grass blade, each 12% shorter than the one before.
#
# A stem may arch over under its own weight (arch: a fern's fronds, a
# bleeding heart's racemes), and its leaves may stand in whorls
# (horsetails, trilliums) instead of singly or in pairs.
#
# Revision 3 (phyllotaxis P1): the leaves are leaves_per_node at a node
# (1 alternate, 2 opposite, more whorled), each node turned divergence
# degrees from the one below, and the basal leaves follow the same turn:
# the names every leaf-bearing program shares, which the rules at the
# vascular plants set from a taxon's leaf_arrangement and
# phyllotaxis_pattern. They replace opposite, phyllotaxis and whorl, with
# the same defaults; the raceme turns by flower_divergence of its own. A
# node's leaves are one ring, spread evenly round the stem: a single leaf
# grows as before, and the leaves of a pair or a whorl now vary in size
# and angle as single leaves do.
#
# Revision 4 (spec rework M7): each basal leaf is drawn within a
# `basal_leaf` structure, its pieces and tip pieces of it. A bud is a
# flower, not a fruit.
#
# Revision 5 (spec rework P6): the first year the plant is adult, from
# which it flowers, is adult_age, the name the programs that measure it
# by the plant's age share, which the rule at the seed plants sets from
# a taxon's juvenile_period_years. It replaces flower_age, with the same
# default.
#
# Revision 6 (growth plan G2.3a): a starting base with no values. Each
# parameter given as a number is `param name;`, and the lineage programs
# that extend it (`apiaceae`, `araceae`, `aristolochiaceae`, `camassia`,
# `maianthemum`, `asteraceae`, `berberidaceae`, `equisetaceae`,
# `fabaceae`, `iridaceae`, `liliaceae`, `melanthiaceae`, `onagraceae`,
# `orchidaceae`, `orobanchaceae`, `oxalidaceae`, `papaveraceae`,
# `phrymaceae`, `plantaginaceae`, `ranunculaceae`, `saxifragaceae`,
# `urticaceae`, `violaceae`) give the values their species leave unset, as
# this program's defaults were until then.
#
# Revision 7 (growth plan G2.3a): an adult cohort's stems need not all
# flower. Only the share flowering_share of them end in a raceme, spread
# evenly round the clump; the rest are leafy stems as tall as a flowering
# stem's leafy part, so a herb whose leaves and flowers rise on separate
# stalks (vanilla leaf, redwood sorrel) draws as many leaves as it has and
# no more flowers. With scape 1 a flowering stem is a leafless scape: a
# bare stalk below its raceme. With flowering_share 1 and scape 0, as its
# lineages give them, a herb grows as before.
#
# Revision 8 (dioecy): in a dioecious species (dioecious 1, from the
# sexual system its taxa state) a plant whose own draw `sex` is below a
# half is male: its racemes bear open flowers where a female's bear
# fruit. The rest are female and fruit as before; so does a plant that
# bears both sexes (dioecious 0).
#
# Revision 9: a flower, bud or fruit of the raceme may stand in the
# axil of a floral bract, a narrow leaf bract_length long from the axis
# beside its stalk, at bract_lean times the stalk's angle (camas's pale
# papery bracts). With bract_length 0, as every program gives it unless
# it says otherwise, no bract is drawn and a herb grows as before.
#
# Revision 10: a flowering stem may branch. Its top flower_branches leaf
# nodes each bear, in the axil of their leaf, a side branch at
# branch_angle to the stem, ending in a raceme like the stem's own
# (fennel's and poison hemlock's candelabra of umbels). The lowest branch
# is branch_length of the stem's height, the topmost half as long.
# Nothing about a branch is drawn at random, which would move other
# herbs' draws. With flower_branches 0, as every program gives it unless
# it says otherwise, a herb grows as before.
#
# Revision 11: a leaf may outlive its year. A flowering stem dies back
# after it fruits, but its basal leaves, and a stem that bears leaves
# only, stay leaf_years (wild ginger's evergreen leaves, a rattlesnake
# plantain's rosette, beargrass's tufts), so an evergreen herb carries
# last year's leaves beside this year's. With leaf_years 1, as every
# program gives it unless a rule says otherwise, a herb grows as before.
#
# Revision 12 (shrub habit): a stem may lie along the ground, as a
# trailing, prostrate or decumbent stem does: with lie above 0 every stem
# leaves its foot nearly level, runs along the ground for the share lie
# of its leafy nodes, turning only from side to side (three times its
# wiggle, so it wanders over the ground), with its leaves
# turned out to its sides in one plane, and over its other nodes turns up
# by rise degrees in all, so its tip and raceme stand nearly upright,
# each turn upward in the frame the stem lay in, whatever the nodes'
# divergence has rolled it to since.
# With lie 0, as every lineage gives it, a herb grows as before.
#
# One step is one year. Angles are degrees; lengths are metres.

lsystem herb 12;

# The clump.
param stems;                  # stems in a mature clump
param stem_rate;              # cohort size: stems * (1 - exp(-stem_rate * age))
param clump_radius;           # radius a mature clump's stems spread over
param stem_lean;              # how far the outermost stems lean out
param maturity;               # years over which stems reach full size
param leaf_years = 1;         # years a basal leaf, or a stem bearing leaves only, stays on: more than 1 for evergreens
param adult_age;              # the first year the plant is adult and flowers
# A stem.
param stem_height;            # stem height at maturity, raceme included
param height_spread;          # stems are stem_height * (1 ± height_spread)
param young_height;           # a stem without a raceme, as a share of stem_height
param stem_radius;            # radius at the base; it halves toward the top
param wiggle;                 # spread of the random turn at each node
param arch;                   # how strongly a stem bends toward the ground at each node
# Leaves along the stem.
param nodes;                  # nodes with leaves
param leaves_per_node;        # leaves at a node: 1 alternate, 2 opposite, more whorled
param divergence = leaves_per_node == 2 ? 90 : 137.5;   # roll from one node to the next
param bare;                   # share of the stem below the raceme without leaves
param leaf_length;            # the longest leaf
param leaf_peak;              # where it sits along the leafy part, 0 to 1
param leaf_top;               # the topmost leaf, as a share of the longest
param leaf_base;              # the lowest leaf, as a share of the longest
param leaf_angle;             # angle of a leaf to the stem
param leaf_area;              # leaf area of a leaf 1 m long, m²
# Basal leaves.
param basal_leaves;           # basal leaves at the foot of each stem
param basal_length;
param basal_angle;            # mean angle of a basal leaf to the vertical
param basal_pieces;           # pieces in a basal leaf
param basal_arch;             # degrees an arching basal leaf bends at each joint
param basal_area;             # leaf area of a basal leaf, or of its last piece, 1 m long
param basal_piece_area;
# The raceme.
param raceme;                 # share of the stem's height that flowers
param flowering_share;        # share of an adult cohort's stems that end in a raceme; the rest bear leaves only
param scape;                  # 1: a flowering stem is a leafless scape, its raceme on a bare stalk
param flowers;                # flowers, fruit and buds on a raceme
param flower_size;            # flower diameter
param pedicel;                # flower stalk length
param flower_divergence;           # roll from one flower of the raceme to the next
param flower_angle;           # angle of a flower stalk to the stem
param fruit_below;            # share of the raceme, from the bottom, in fruit
param dioecious;              # 1: each plant is male or female; 0: every plant bears both
param sex;                    # this plant's own draw, 0 to 1: below a half, a dioecious plant is male
param buds_above;             # share of the raceme above which are buds
param fruit_length;
param fruit_angle;
param bud_size;
param bud_spacing;            # a bud's internode as a share of a flower's: below 1 the buds crowd toward the tip
param bud_lean;               # a bud's stalk angle as a share of flower_angle: near 0 the buds stand pressed to the axis
param bud_stalk;              # a bud's stalk as a share of pedicel
param nod;                    # degrees the bud-tipped end bends over
param bract_length = 0;       # a floral bract's length below each stalk of the raceme; 0: none
param bract_lean = 1.1;       # a bract's angle to the axis as a share of its stalk's
param bract_area = 0.235;     # leaf area of a bract 1 m long, m² (the default leaf card's)
param flower_branches = 0;    # top leaf nodes of a flowering stem that bear a flowering side branch
param branch_angle = 40;      # angle of a side branch to the stem
param branch_length = 0.3;    # the lowest side branch's length, as a share of the stem's height
param flower_area;
param bud_area;
param fruit_area;
param light_cell;             # light voxel edge
param lie = 0;                # share of a stem's leafy nodes lying along the ground; 0: none
param rise = 80;              # degrees a lying stem turns up over its other nodes

module Y;                     # the crown: sends up a cohort each year
module Ss(k, m, n);           # stems k to k + m - 1 of a cohort of n
module Sm;                    # the base of a stem
module Sw(r);                 # where a stem leaves its basal leaves: r of it a raceme
module Bs(j);                 # j basal leaves still to place
module Bl(len, a);            # a basal leaf len long bending a at each joint
module Pc(k, s, a);           # piece k of a basal leaf, s long
module St(h, r);              # a stem h tall with a raceme r long
module Sv(h, r);              # the same stem, past where it leaves its basal leaves
module Nd(i, m, h, r);        # leaf nodes i to i + m - 1 of a stem
module Rc(i, m, h, r);        # raceme nodes i to i + m - 1
module Lf(s);                 # the leaves at one node
module Br(a);                 # a floral bract, a degrees from the axis
module Bx(i, h, r);           # the side branch, if any, at leaf node i of a stem
module Bh(len);               # a flowering side branch len long

organ leaf leaf area leaf_area;
organ basal leaf as piece area basal_area;
organ basal_piece leaf as piece area basal_piece_area;
organ flower flower area flower_area;
organ bud fruit as flower area bud_area;
organ fruit fruit area fruit_area;
organ bract leaf as inflorescence_bract area bract_area;

structure basal_leaf leaf;    # one basal leaf: its pieces and tip

tool light@1 { cell = light_cell, extinction = 0.5 };

axiom Y;

# The cohort grows toward full size with the plant's age; t is the age the
# cohort is drawn at.
rule Y -> Ss(0, -1, 0) Y;
decompose Ss(k, m, n) : m < 0 ->
    Ss(0, max(1, round(stems * (1 - exp(-stem_rate * t)))),
          max(1, round(stems * (1 - exp(-stem_rate * t)))));
decompose Ss(k, m, n) : m > 1 ->
    Ss(k, floor(m / 2), n) Ss(k + floor(m / 2), m - floor(m / 2), n);
# One stem: out along the sunflower spiral, up, and leaning out.
decompose Ss(k, m, n) : m == 1 ->
    [ Sm /(k * 137.508 + uniform(-15, 15)) &(90)
      f(clump_radius * sqrt(n / stems) * sqrt((k + uniform(0.2, 0.8)) / n)) ^(90)
      &((lie > 0 ? 88.5 : stem_lean * sqrt((k + 0.5) / n)) + uniform(0, 3) * (lie > 0 ? 0.5 : 1))
      Bs(basal_leaves)
      St(stem_height * (1 - exp(-t / maturity)) * uniform(1 - height_spread, 1 + height_spread)
         * (t < adult_age ? young_height
            : floor((k + 1) * flowering_share) > floor(k * flowering_share) ? 1 : 1 - raceme),
         t >= adult_age && floor((k + 1) * flowering_share) > floor(k * flowering_share) ? raceme : 0) ];
decompose Ss(k, m, n) -> ;

# Basal leaves, spread round the stem's foot.
decompose Bs(j) : j > 0 ->
    [ /(j * divergence + uniform(-30, 30)) &(basal_angle * uniform(0.6, 1.4)) $
      Bl(basal_length * (1 - exp(-t / maturity)) * uniform(0.75, 1.25),
         basal_arch * uniform(0.6, 1.4)) ]
    Bs(j - 1);
decompose Bs(j) -> ;
decompose Bl(len, a) -> basal_leaf Pc(0, len * 0.12 / (1 - pow(0.88, basal_pieces)), a);
decompose Pc(k, s, a) : k < basal_pieces - 1 ->
    basal_piece(s) f(s) /(gauss() * 4) &(a) Pc(k + 1, s * 0.88, a);
decompose Pc(k, s, a) -> basal(s);

# A stem h tall: a bare foot, the leafy part, then the raceme, r of the
# height. Nodes split in halves so a long stem stays within the
# decomposition depth. Where leaves outlive their year, the stem starts
# where it leaves its basal leaves (Sw); with leaf_years 1 it needs no
# mark, so every draw stays where it was.
decompose St(h, r) : leaf_years > 1 -> Sw(r) Sv(h, r);
decompose Sv(h, r) : arch > 0 ->
    T(0, -1, 0, arch) !(stem_radius) F(h * (1 - r) * (r > 0 && scape > 0 ? 1 : bare))
    Nd(0, r > 0 && scape > 0 ? 0 : nodes, h, r) Rc(0, r > 0 ? flowers : 0, h, r);
decompose Sv(h, r) ->
    !(stem_radius) F(h * (1 - r) * (r > 0 && scape > 0 ? 1 : bare))
    Nd(0, r > 0 && scape > 0 ? 0 : nodes, h, r) Rc(0, r > 0 ? flowers : 0, h, r);
decompose St(h, r) : arch > 0 ->
    T(0, -1, 0, arch) !(stem_radius) F(h * (1 - r) * (r > 0 && scape > 0 ? 1 : bare))
    Nd(0, r > 0 && scape > 0 ? 0 : nodes, h, r) Rc(0, r > 0 ? flowers : 0, h, r);
decompose St(h, r) ->
    !(stem_radius) F(h * (1 - r) * (r > 0 && scape > 0 ? 1 : bare))
    Nd(0, r > 0 && scape > 0 ? 0 : nodes, h, r) Rc(0, r > 0 ? flowers : 0, h, r);
decompose Nd(i, m, h, r) : m > 1 ->
    Nd(i, floor(m / 2), h, r) Nd(i + floor(m / 2), m - floor(m / 2), h, r);
# One node: an internode, then its leaves, sized by where the node sits
# between the foot and the top of the leafy part.
decompose Nd(i, m, h, r) : m == 1 ->
    /(lie > 0 && i >= round(lie * nodes) ? -(round(lie * nodes) * (leaves_per_node == 2 ? 0 : 180) + (i - round(lie * nodes)) * divergence) : 0)
    ^(lie > 0 && i >= round(lie * nodes) ? rise / max(1, nodes - round(lie * nodes)) : 0)
    /(lie > 0 && i >= round(lie * nodes) ? (round(lie * nodes) * (leaves_per_node == 2 ? 0 : 180) + (i - round(lie * nodes)) * divergence) : 0)
    ^(gauss() * wiggle * (lie > 0 && i < round(lie * nodes) ? 0 : 1)) +(gauss() * wiggle * (lie > 0 && i < round(lie * nodes) ? 3 : 1))
    !(stem_radius * (1 - 0.5 * ((h * (1 - r) * bare + (i + 1) * h * (1 - r) * (1 - bare) / nodes) / h)))
    F(h * (1 - r) * (1 - bare) / nodes)
    /(lie > 0 && i < round(lie * nodes) ? 90 : 0)
    Lf(leaf_length * (1 - exp(-t / maturity))
       * ((i + 0.5) / nodes < leaf_peak
          ? lerp(leaf_base, 1, (i + 0.5) / nodes / leaf_peak)
          : lerp(1, leaf_top, ((i + 0.5) / nodes - leaf_peak) / (1 - leaf_peak))))
    Bx(i, h, r) /(lie > 0 && i < round(lie * nodes) ? (leaves_per_node == 2 ? -90 : 90) : divergence);
decompose Nd(i, m, h, r) -> ;
# The leaves at a node, spread evenly round the stem.
decompose Lf(s) ->
    ring(leaves_per_node) [ &(leaf_angle * uniform(0.85, 1.15)) $ leaf(s * uniform(0.9, 1.1)) ];

# A flowering stem's top flower_branches nodes each bear a side branch in
# the axil of their leaf, shorter toward the top, ending in a raceme. A
# branch is as thick as the raceme's own axis, so the two join smoothly.
# The branches draw nothing at random: random call sites are numbered
# through the program and the programs built on it, so a draw here would
# move every later draw of every herb.
decompose Bx(i, h, r) : r > 0 && flower_branches > 0 && i >= nodes - flower_branches ->
    [ &(branch_angle)
      Bh(h * branch_length
         * lerp(1, 0.5, (i - max(0, nodes - flower_branches)) / max(1, min(nodes, flower_branches) - 1))) ];
decompose Bx(i, h, r) -> ;
decompose Bh(len) ->
    !(stem_radius * 0.5) F(len * (1 - raceme)) Rc(0, flowers, len, raceme);

# The raceme: fruit, then open flowers, then buds, the buds' part bending
# over toward its tip. A male plant's fruit are open flowers.
decompose Rc(i, m, h, r) : m > 1 ->
    Rc(i, floor(m / 2), h, r) Rc(i + floor(m / 2), m - floor(m / 2), h, r);
decompose Rc(i, m, h, r) : m == 1 && (i + 0.5) / flowers < fruit_below
                          && (dioecious < 0.5 || sex >= 0.5) ->
    !(stem_radius * 0.5) F(h * r / flowers)
    [ &(fruit_angle * uniform(0.8, 1.2)) fruit(fruit_length * uniform(0.85, 1.1)) ] Br(fruit_angle)
    /(flower_divergence);
decompose Rc(i, m, h, r) : m == 1 && (i + 0.5) / flowers < buds_above ->
    !(stem_radius * 0.5) F(h * r / flowers)
    [ &(flower_angle * uniform(0.8, 1.2)) !(stem_radius * 0.2) F(pedicel)
      flower(flower_size * uniform(0.9, 1.1)) ] Br(flower_angle)
    /(flower_divergence);
decompose Rc(i, m, h, r) : m == 1 ->
    &(nod / max(1, flowers * (1 - buds_above))) !(stem_radius * 0.5) F(h * r / flowers * bud_spacing)
    [ &(flower_angle * bud_lean) !(stem_radius * 0.2) F(pedicel * bud_stalk)
      bud(bud_size * lerp(1, 0.5, ((i + 0.5) / flowers - buds_above) / max(0.01, 1 - buds_above))) ]
    Br(flower_angle * bud_lean) /(flower_divergence);
decompose Rc(i, m, h, r) -> ;
# A floral bract beside the stalk before it, on the same side. It comes
# after the stalk so the stalk's own draws are as they were.
decompose Br(a) : bract_length > 0 ->
    [ &(a * bract_lean * uniform(0.85, 1.15)) $ bract(bract_length * uniform(0.85, 1.15)) ];
decompose Br(a) -> ;

# Last year's flowering stems are gone; their basal leaves, and stems
# bearing leaves only, stay leaf_years.
rule Sw(r) : r > 0 -> %;
rule Sm : age + dt >= leaf_years -> %;
